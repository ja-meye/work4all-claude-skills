              </ExpressionBindings>
              <StylePriority Ref="790" UsePadding="false" />
            </Item1>
          </Controls>
          <ExpressionBindings>
            <Item1 Ref="791" EventName="BeforePrint" PropertyName="Visible" Expression="Iif(&#xA;&#x9;(&#xA;&#x9;&#x9;IsNullOrEmpty(Trim([ERP_Kopftext])) Or &#x9;&#xA;&#x9;&#x9;IsNullOrEmpty(Trim([ERP_RTFKopftext]))&#xA;&#x9;) Or&#xA;&#x9;(&#xA;&#x9;&#x9;Not IsNull([ERP_WartungsobjektCode]) And&#xA;&#x9;&#x9;[ERP_WartungsobjektCode] != 0&#xA;&#x9;),&#xA;&#x9;false,&#xA;&#x9;true)&#xA;&#xA;/* Aktuell gibt es einen Bug ERP_Kopftext wird in web nicht leer gemacht, aber RTF_Kopftext wird leer gemacht, daher Prüfung jetzt auf beide Felder eingearbeitet (Stand 09.10.2025) || Und es gibt ein Problem mit der RTF Formatierung bei Aboverträgen, daher wird bei Rechnungen aus Aboverträgen der Plain Kopftext ausgegeben.*/" />
          </ExpressionBindings>
        </Item6>
