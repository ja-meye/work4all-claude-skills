          <ExpressionBindings>
            <Item1 Ref="796" EventName="BeforePrint" PropertyName="Visible" Expression="Iif(&#xA;&#x9;IsNullOrEmpty(Trim([ERP_Kopftext])) Or &#x9;&#xA;&#x9;IsNullOrEmpty(Trim([ERP_RTFKopftext])) Or&#xA;&#x9;IsNull([ERP_WartungsobjektCode]) Or&#xA;&#x9;[ERP_WartungsobjektCode] == 0,&#xA;&#x9;false,&#xA;&#x9;true&#xA;)&#xA;&#xA;/* Es gibt ein Problem mit der RTF Formatierung bei Aboverträgen, daher wird bei Rechnungen aus Aboverträgen der Plain Kopftext ausgegeben.*/&#xA;" />
