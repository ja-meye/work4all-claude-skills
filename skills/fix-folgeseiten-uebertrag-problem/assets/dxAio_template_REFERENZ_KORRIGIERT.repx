                        <Item2 Ref="622" EventName="BeforePrint" PropertyName="Text" Expression="/* Bestellnummer */&#xA;Iif(&#xA;    Not IsNullOrEmpty(Trim([ERP_Bestellnummer_BT13])) &#xA;    And [ERP_BZObjType] In ('5', '6', '7', '8'),    &#xA;    [ERP_Bestellnummer_BT13], &#xA;    ''&#xA;)&#xA;" />
