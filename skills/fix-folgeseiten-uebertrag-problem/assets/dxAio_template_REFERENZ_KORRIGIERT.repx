              <ReportSource Ref="806" ControlType="DXWebAIO.SubReportSum, DXWebAIO, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" Dpi="254" ScriptsSource="// Variablen************************************************************************************************************&#xD;&#xA;double zwischensumme = 0;&#xD;&#xA;double titelsumme = 0;&#xD;&#xA;double belegRabattSumme = 0;&#xD;&#xA;double belegZuschlagSumme = 0;&#xD;&#xA;&#xD;&#xA;// Detail-Sektion - entspricht Berechnungslogik pro Position in CrystalReports  =======================&#xD;&#xA;private void Detail_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        object artikelArtObj = GetCurrentColumnValue(&quot;ArtikelArt&quot;);&#xD;&#xA;        object value = GetCurrentColumnValue(&quot;GesPreis&quot;);&#xD;&#xA;&#xD;&#xA;        string artikelArt = artikelArtObj != null ? Convert.ToString(artikelArtObj).Trim() : &quot;&quot;;&#xD;&#xA;        double gesPreis = Convert.ToDouble(value);&#xD;&#xA;&#xD;&#xA;        // Reset bei bestimmten Artikelarten (wie zuvor)&#xD;&#xA;        switch (artikelArt)&#xD;&#xA;        {&#xD;&#xA;            case &quot;-3&quot;:&#xD;&#xA;                titelsumme = 0;&#xD;&#xA;                break;&#xD;&#xA;            case &quot;-13&quot;:&#xD;&#xA;                zwischensumme = 0;&#xD;&#xA;                break;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        // Summierung für Rabatt/Zuschlag&#xD;&#xA;        if (artikelArtObj != null &amp;&amp; value != null)&#xD;&#xA;        {&#xD;&#xA;            int art = Convert.ToInt32(artikelArtObj);&#xD;&#xA;            double preis = Convert.ToDouble(value);&#xD;&#xA;&#xD;&#xA;            if (art == -20 &amp;&amp; preis &lt; 0)&#xD;&#xA;                belegRabattSumme += gesPreis;&#xD;&#xA;&#xD;&#xA;            if (art == -21 &amp;&amp; preis &gt; 0)&#xD;&#xA;                belegZuschlagSumme += gesPreis;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    catch (Exception ex)&#xD;&#xA;    {&#xD;&#xA;        // Optional: Logging&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void tblGPreis_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void Detail_AfterPrint(object sender, System.EventArgs e) {&#xD;&#xA;&#xD;&#xA;&#x9;object value = GetCurrentColumnValue(&quot;GesPreis&quot;); &#xD;&#xA;&#x9;if (value != null) &#xD;&#xA;&#x9;{&#xD;&#xA;&#x9;&#x9;double val = Convert.ToDouble(value); &#xD;&#xA;&#x9;&#x9;titelsumme += val; &#xD;&#xA;&#x9;&#x9;zwischensumme += val; &#xD;&#xA;&#x9;} &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void tc_GPreis_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    XRTableCell cell = sender as XRTableCell;&#xD;&#xA;&#xD;&#xA;    object artikelArtObj = GetCurrentColumnValue(&quot;ArtikelArt&quot;);&#xD;&#xA;    if (artikelArtObj == null)&#xD;&#xA;    {&#xD;&#xA;        cell.Text = string.Empty;&#xD;&#xA;        return;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    int artikelArt = Convert.ToInt32(artikelArtObj);&#xD;&#xA;&#xD;&#xA;    // Sprachcode ermitteln&#xD;&#xA;    int spracheCode = Convert.ToInt32(this.Parameters[&quot;Context_BzObjectLanguageCode&quot;].Value);&#xD;&#xA;&#xD;&#xA;    switch (artikelArt)&#xD;&#xA;    {&#xD;&#xA;        case 0: // normal&#xD;&#xA;            break;&#xD;&#xA;&#xD;&#xA;        case -2: // Titelsumme&#xD;&#xA;            if (titelsumme == 0)&#xD;&#xA;            {&#xD;&#xA;                switch (spracheCode)&#xD;&#xA;                {&#xD;&#xA;                    case 13: // Englisch&#xD;&#xA;                        cell.Text = &quot;TBD&quot;;&#xD;&#xA;                        break;&#xD;&#xA;                    case 14: // Französisch&#xD;&#xA;                        cell.Text = &quot;encore ouvert&quot;;&#xD;&#xA;                        break;&#xD;&#xA;                    default: // Deutsch&#xD;&#xA;                        cell.Text = &quot;noch offen&quot;;&#xD;&#xA;                        break;&#xD;&#xA;                }&#xD;&#xA;            }&#xD;&#xA;            else&#xD;&#xA;            {&#xD;&#xA;                cell.Text = titelsumme.ToString(&quot;N2&quot;);&#xD;&#xA;            }&#xD;&#xA;            break;&#xD;&#xA;&#xD;&#xA;        case -12: // Zwischensumme&#xD;&#xA;            cell.Text = zwischensumme.ToString(&quot;N2&quot;);&#xD;&#xA;            break;&#xD;&#xA;&#xD;&#xA;        default:&#xD;&#xA;            cell.Text = string.Empty;&#xD;&#xA;            break;&#xD;&#xA;    }  &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void tc_Belegrabatt_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    XRTableCell cell = sender as XRTableCell;&#xD;&#xA;    cell.Text = belegRabattSumme.ToString(&quot;N2&quot;);    &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void tc_Belegzuschlag_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    XRTableCell cell = sender as XRTableCell;&#xD;&#xA;    cell.Text = belegZuschlagSumme.ToString(&quot;N2&quot;);    &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void SubBand_BelegRabatt_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    // Nur anzeigen, wenn Rabatt existiert (also &lt; 0)&#xD;&#xA;    if (belegRabattSumme &gt;= 0)&#xD;&#xA;        e.Cancel = true;  &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void SubBand_BelegZuschlag_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    // Nur anzeigen, wenn Zuschlag existiert (also &gt; 0)&#xD;&#xA;    if (belegZuschlagSumme &lt;= 0)&#xD;&#xA;        e.Cancel = true;    &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;" SnapGridSize="25" SnappingMode="SnapToGridAndSnapLines" ReportUnit="TenthsOfAMillimeter" PageWidthF="2100" PageHeightF="2970" Version="25.1" DataMember="Positionen_1" DataSource="#Ref-805">
