              <ReportSource Ref="1774" ControlType="DXWebAIO.SubReportSignatur, DXWebAIO, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" Dpi="254" ScriptsSource="private void xrPictureBox1_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e)&#xD;&#xA;{&#xD;&#xA;    XRPictureBox box = sender as XRPictureBox;&#xD;&#xA;    if (box == null) return;&#xD;&#xA;&#xD;&#xA;    object imageData = GetCurrentColumnValue(&quot;DAT_Data&quot;);&#xD;&#xA;&#xD;&#xA;    // null / DBNull&#xD;&#xA;    if (imageData == null || imageData == DBNull.Value)&#xD;&#xA;    {&#xD;&#xA;        box.Visible = false;&#xD;&#xA;        return;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    string base64 = Convert.ToString(imageData);&#xD;&#xA;&#xD;&#xA;    // leer / typische &quot;Fake-Werte&quot;&#xD;&#xA;    if (string.IsNullOrWhiteSpace(base64) ||&#xD;&#xA;        base64 == &quot;0&quot; ||&#xD;&#xA;        base64.Equals(&quot;false&quot;, StringComparison.OrdinalIgnoreCase))&#xD;&#xA;    {&#xD;&#xA;        box.Visible = false;&#xD;&#xA;        return;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // Leerzeichen entfernen&#xD;&#xA;    base64 = System.Text.RegularExpressions.Regex.Replace(base64, @&quot;\s+&quot;, &quot;&quot;);&#xD;&#xA;&#xD;&#xA;    // einfache Base64-Validierung&#xD;&#xA;    if (base64.Length % 4 != 0)&#xD;&#xA;    {&#xD;&#xA;        box.Visible = false;&#xD;&#xA;        return;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        Convert.FromBase64String(base64);&#xD;&#xA;        box.Visible = true;&#xD;&#xA;    }&#xD;&#xA;    catch&#xD;&#xA;    {&#xD;&#xA;        box.Visible = false;&#xD;&#xA;    }&#xD;&#xA;}" SnapGridSize="31.75" SnappingMode="SnapToGridAndSnapLines" ReportUnit="TenthsOfAMillimeter" Margins="0, 0, 5, 30" PaperKind="A4" PageWidthF="2100" PageHeightF="2970" Version="25.1" DataMember="w4a_ERPObjectDateien" DataSource="#Ref-1773" Font="Arial, 9.75pt">
