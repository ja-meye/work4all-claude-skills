                <Item3 Ref="2479" EventName="BeforePrint" PropertyName="Text" Expression="/* Hier wird geprüft ob ein Übergabeparameter leer ist. Dann werden die Pipe Zeichen nicht gdruckt */&#xA;&#xA;Iif(IsNullOrEmpty(?CurrentTenant_Name), '', ?CurrentTenant_Name)&#xA;&#xA;+ Iif(&#xA;    IsNullOrEmpty(?CurrentTenant_Straße),&#xA;    '',&#xA;    Iif(IsNullOrEmpty(?CurrentTenant_Name), '', '  |  ') + ?CurrentTenant_Straße&#xA;  )&#xA;&#xA;+ Iif(&#xA;    IsNullOrEmpty(?CurrentTenant_Staat),&#xA;    '',&#xA;    Iif(&#xA;      IsNullOrEmpty(?CurrentTenant_Name) And IsNullOrEmpty(?CurrentTenant_Straße),&#xA;      '',&#xA;      '  |  '&#xA;    ) + ?CurrentTenant_Staat&#xA;  )&#xA;&#xA;+ Iif(&#xA;    IsNullOrEmpty(?CurrentTenant_PLZ),&#xA;    '',&#xA;    Iif(&#xA;      IsNullOrEmpty(?CurrentTenant_Name)&#xA;      And IsNullOrEmpty(?CurrentTenant_Straße)&#xA;      And IsNullOrEmpty(?CurrentTenant_Staat),&#xA;      '',&#xA;      ' '&#xA;    ) + ?CurrentTenant_PLZ&#xA;  )&#xA;&#xA;+ Iif(&#xA;    IsNullOrEmpty(?CurrentTenant_Ort),&#xA;    '',&#xA;    Iif(&#xA;      IsNullOrEmpty(?CurrentTenant_Name)&#xA;      And IsNullOrEmpty(?CurrentTenant_Straße)&#xA;      And IsNullOrEmpty(?CurrentTenant_Staat)&#xA;      And IsNullOrEmpty(?CurrentTenant_PLZ),&#xA;      '',&#xA;      ' '&#xA;    ) + ?CurrentTenant_Ort&#xA;  )&#xA;&#xA;+ Iif(&#xA;    IsNullOrEmpty(?CurrentTenant_WWW),&#xA;    '',&#xA;    Iif(&#xA;      IsNullOrEmpty(?CurrentTenant_Name)&#xA;      And IsNullOrEmpty(?CurrentTenant_Straße)&#xA;      And IsNullOrEmpty(?CurrentTenant_Staat)&#xA;      And IsNullOrEmpty(?CurrentTenant_PLZ)&#xA;      And IsNullOrEmpty(?CurrentTenant_Ort),&#xA;      '',&#xA;      '  |  '&#xA;    ) + ?CurrentTenant_WWW&#xA;  )&#xA;" />
              </ExpressionBindings>
              <StylePriority Ref="2480" UseForeColor="false" UsePadding="false" UseBorderColor="false" UseBorders="false" UseBorderWidth="false" />
            </Item2>
