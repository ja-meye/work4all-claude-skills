<?xml version="1.0" encoding="utf-8"?>
<XtraReportsLayoutSerializer SerializerVersion="25.1.3.0" Ref="1" ControlType="DevExpress.XtraReports.UI.XtraReport, DevExpress.XtraReports.v25.1, Version=25.1.3.0, Culture=neutral, PublicKeyToken=b88d1754d700e49a" Name="dxAio_template" Dpi="254" ScriptsSource="// ******************************************************************************************************************&#xD;&#xA;// Variablen&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;decimal zwischensumme = 0;&#xD;&#xA;decimal titelsumme = 0;&#xD;&#xA;int pageCounter = 0;&#xD;&#xA;int Lizenz = 0;  //work4all Artikel Hauptgruppe = Lizenzen | GrCode=505172731&#xD;&#xA;int ArtikelServerHosting = 0;  //work4all Artikel Obergruppe = ServerHosting | in CR Artikel697&#xD;&#xA;private int frei3Counter = 0;  //check if StattGPreis Artikel im ERP-Objekt vorkommen&#xD;&#xA;decimal _carryValueUnten = 0m; //Übertrag Fußzeile&#xD;&#xA;decimal _carryValueOben = 0m; //Übertrag Folgeseite&#xD;&#xA;decimal _docGesamtGesPreis = 0m; //Gesamtsumme (POS_GesPreis) des kompletten Belegs, seitenunabhängig.&#xD;&#xA;                                  //Dient als robuste Zusatzbedingung für die Übertrag-/Folgeseiten-Unterdrückung:&#xD;&#xA;                                  //Auch wenn die bisherige Carryover-Summe auf einer Seite noch 0 ist (z. B. weil&#xD;&#xA;                                  //ein langer Kopftext die erste Position mit Preis auf die Folgeseite verschiebt),&#xD;&#xA;                                  //soll der Übertrag/Tabellenkopf trotzdem angezeigt werden, sofern der Beleg&#xD;&#xA;                                  //insgesamt überhaupt Positionen mit Preis enthält.&#xD;&#xA;bool _detailPrintedSoFar = false; //Wird true, sobald die erste Zeile des eigentlichen Detailbereichs (Sub_POS) tatsächlich&#xD;&#xA;                                   //gedruckt wurde (siehe tc_GPreis_PrintOnPage weiter unten). Notwendig, weil&#xD;&#xA;                                   //_docGesamtGesPreis allein nicht zwischen &quot;Detailbereich hat schon begonnen&quot; und&#xD;&#xA;                                   //&quot;Detailbereich hat noch gar nicht begonnen&quot; unterscheiden kann: vorgelagerter Inhalt&#xD;&#xA;                                   //(sehr langer Kopftext, oder die über ArgShowTitleOverview gesteuerte Titelübersicht&#xD;&#xA;                                   //Sub_Titelsummen inkl. Belegrabatt/Belegzuschlag) kann selbst mehrseitig sein, bevor&#xD;&#xA;                                   //Sub_POS überhaupt anfängt. Ohne dieses Flag wurde Übertrag/Folgeseiten-Titel dann&#xD;&#xA;                                   //fälschlich schon auf diesen vorgelagerten Seiten angezeigt (mit leerem Wert), obwohl&#xD;&#xA;                                   //es dort noch nichts zu übertragen gibt.&#xD;&#xA;&#xD;&#xA;// *********************************************************************************************************************&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;// Report Berechnungslogiken&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;&#xD;&#xA;// Zentrale Helper für sichere Konvertierungen (object -&gt; int/string/bool).&#xD;&#xA;// Behandelt null und DBNull explizit, um Laufzeitfehler im Report zu vermeiden.&#xD;&#xA;// Wandelt Objekt sicher in int um; gibt Fallback bei null/DBNull zurück&#xD;&#xA;private int ToIntSafe(object value, int fallback)&#xD;&#xA;{&#xD;&#xA;    if (value == null || value == DBNull.Value)&#xD;&#xA;        return fallback;&#xD;&#xA;&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        return Convert.ToInt32(value);&#xD;&#xA;    }&#xD;&#xA;    catch&#xD;&#xA;    {&#xD;&#xA;        return fallback;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Wandelt Objekt sicher in string um; gibt leeren String bei null/DBNull zurück&#xD;&#xA;private string ToStringSafe(object value)&#xD;&#xA;{&#xD;&#xA;    if (value == null || value == DBNull.Value)&#xD;&#xA;        return string.Empty;&#xD;&#xA;&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        return Convert.ToString(value);&#xD;&#xA;    }&#xD;&#xA;    catch&#xD;&#xA;    {&#xD;&#xA;        return string.Empty;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Wandelt Objekt sicher in bool um; gibt Fallback bei null/DBNull zurück&#xD;&#xA;private bool ToBoolSafe(object value, bool fallback)&#xD;&#xA;{&#xD;&#xA;    if (value == null || value == DBNull.Value)&#xD;&#xA;        return fallback;&#xD;&#xA;&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        return Convert.ToBoolean(value);&#xD;&#xA;    }&#xD;&#xA;    catch&#xD;&#xA;    {&#xD;&#xA;        return fallback;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private decimal ToDecimalSafe(object value, decimal fallback = 0m)&#xD;&#xA;{&#xD;&#xA;    if (value == null || value == DBNull.Value)&#xD;&#xA;        return fallback;&#xD;&#xA;&#xD;&#xA;    if (value is decimal)&#xD;&#xA;        return (decimal)value;&#xD;&#xA;&#xD;&#xA;    string text = Convert.ToString(value);&#xD;&#xA;    if (text != null)&#xD;&#xA;        text = text.Trim();&#xD;&#xA;&#xD;&#xA;    if (string.IsNullOrWhiteSpace(text))&#xD;&#xA;        return fallback;&#xD;&#xA;&#xD;&#xA;    decimal result;&#xD;&#xA;&#xD;&#xA;    // 1. Try current culture (e.g. &quot;1.234,56&quot;)&#xD;&#xA;    if (decimal.TryParse(&#xD;&#xA;        text,&#xD;&#xA;        System.Globalization.NumberStyles.Any,&#xD;&#xA;        System.Globalization.CultureInfo.CurrentCulture,&#xD;&#xA;        out result))&#xD;&#xA;    {&#xD;&#xA;        return result;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // 2. Try invariant culture (&quot;1234.56&quot;)&#xD;&#xA;    if (decimal.TryParse(&#xD;&#xA;        text,&#xD;&#xA;        System.Globalization.NumberStyles.Any,&#xD;&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;        out result))&#xD;&#xA;    {&#xD;&#xA;        return result;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    return fallback;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private object GetParamSafe(string name)&#xD;&#xA;{&#xD;&#xA;    return Parameters[name] == null ? null : Parameters[name].Value;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// Hilfsmethode: ermittelt den Titeltext anhand Sprachcode, Objekttyp und Rechnungsart&#xD;&#xA;private string GetTitelText()&#xD;&#xA;{&#xD;&#xA;    int sprachCode           = ToIntSafe(GetCurrentColumnValue(&quot;_SprachCodeERP&quot;), 0);&#xD;&#xA;    int objType              = ToIntSafe(GetCurrentColumnValue(&quot;ERP_BZObjType&quot;), 0);&#xD;&#xA;    string nummer            = ToStringSafe(GetCurrentColumnValue(&quot;ERP_Nummer&quot;));&#xD;&#xA;    string invoiceTypeBT3    = ToStringSafe(GetCurrentColumnValue(&quot;ERP_Rechnungsart_BT3&quot;));&#xD;&#xA;    invoiceTypeBT3 = invoiceTypeBT3 == null ? null : invoiceTypeBT3.Trim();     &#xD;&#xA;&#xD;&#xA;    // Zugriff auf Boolean-Parameter&#xD;&#xA;    bool proforma = ToBoolSafe(GetParamSafe(&quot;ArgProforma&quot;), false);  &#xD;&#xA;    bool downPayment = ToBoolSafe(GetParamSafe(&quot;ArgDownPayment&quot;), false);&#xD;&#xA;    // [LS] Leistungsnachweis&#xD;&#xA;    bool lsLeistungsnachweis = ToBoolSafe(GetParamSafe(&quot;ArgLeistungsnachweis&quot;), false);&#xD;&#xA;&#xD;&#xA;    // Defaultwerte (werden nur bei Bedarf überschrieben)&#xD;&#xA;    int invoiceArt = 0;&#xD;&#xA;    int sdobjType  = -1;&#xD;&#xA;    &#xD;&#xA;    // Sonderfälle: &#xD;&#xA;    // &quot;Anzahlungsrechnung&quot; (nur bei Teilrechnung möglich):&#xD;&#xA;    // In DE sind, zumindest für öffentliche Auftraggeber, &quot;Anzahlungsrechnungen&quot; (BT-3-Code &quot;386&quot;)&#xD;&#xA;    // nicht erlaubt. Es soll aber zumindest über eine Druckoption oder RE-Art &quot;3&quot; möglich sein, auf der Teilrechnung &quot;Anzahlungsrechnung&quot;&#xD;&#xA;    // erscheinen zu lassen.&#xD;&#xA;    // BzObjType 4 = Kalkulation (Druckopt.: 215)&#xD;&#xA;    // BzObjType 8 = Rücklieferschein (SDObjType = 0)(Druckopt.: 4)&#xD;&#xA;    // BzObjType 10 = Bedarfsanforderung (Druckopt.: 10)&#xD;&#xA;&#xD;&#xA;    // Sonderlogik nach Objekttyp&#xD;&#xA;    switch (objType)&#xD;&#xA;    {&#xD;&#xA;        case 5:&#xD;&#xA;            if (proforma)&#xD;&#xA;            {&#xD;&#xA;                objType = 51;&#xD;&#xA;            }&#xD;&#xA;            break;&#xD;&#xA;&#xD;&#xA;        case 8:&#xD;&#xA;            sdobjType = ToIntSafe(GetCurrentColumnValue(&quot;ERP_SDObjType&quot;), -1);&#xD;&#xA;&#xD;&#xA;            if (sdobjType == 0)&#xD;&#xA;            {&#xD;&#xA;                objType = 81;&#xD;&#xA;            }&#xD;&#xA;            else if (sdobjType == 1 &amp;&amp; lsLeistungsnachweis)&#xD;&#xA;            {&#xD;&#xA;                objType = 82;&#xD;&#xA;            }&#xD;&#xA;            break;&#xD;&#xA;&#xD;&#xA;        case 7:&#xD;&#xA;            invoiceArt = ToIntSafe(GetCurrentColumnValue(&quot;ERP_Art&quot;), 0);&#xD;&#xA;&#xD;&#xA;            switch (invoiceArt)&#xD;&#xA;            {&#xD;&#xA;                case 0:&#xD;&#xA;                    if (string.IsNullOrWhiteSpace(invoiceTypeBT3) || invoiceTypeBT3 == &quot;0&quot;)&#xD;&#xA;                    {&#xD;&#xA;                        invoiceTypeBT3 = &quot;380&quot;;&#xD;&#xA;                    }&#xD;&#xA;                    break;&#xD;&#xA;                    &#xD;&#xA;                case 1: &#xD;&#xA;                    // Nur wenn kein gültiger BT-3-Code vorhanden ist (null, leer oder &quot;0&quot;), Default setzen.&#xD;&#xA;                    // Vorhandene Werte wie &quot;876&quot;, &quot;326&quot; oder &quot;386&quot; bleiben unverändert.&#xD;&#xA;                    if (string.IsNullOrWhiteSpace(invoiceTypeBT3) || invoiceTypeBT3 == &quot;0&quot;)&#xD;&#xA;                    {&#xD;&#xA;                        invoiceTypeBT3 = downPayment ? &quot;386&quot; : &quot;326&quot;;&#xD;&#xA;                    }&#xD;&#xA;                    break;&#xD;&#xA;                &#xD;&#xA;                case 2: invoiceTypeBT3 = &quot;877&quot;; break;&#xD;&#xA;&#xD;&#xA;                case 3: invoiceTypeBT3 = &quot;386&quot;; break;&#xD;&#xA;            }&#xD;&#xA;            break;&#xD;&#xA;    }&#xD;&#xA;  &#xD;&#xA;    string titel = &quot;&quot;;&#xD;&#xA;&#xD;&#xA;    switch (sprachCode)&#xD;&#xA;    {&#xD;&#xA;&#x9;case 0: // Deutsch&#xD;&#xA;&#x9;&#x9;switch (objType)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;case 4:    titel = &quot;Kalkulation&quot;; break;  // Neuer Code von ak&#xD;&#xA;    &#x9;&#x9;&#x9;case 6:    titel = &quot;Angebot&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 5:    titel = &quot;Auftragsbestätigung&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 51:   titel = &quot;Proformarechnung&quot;; break;               &#xD;&#xA;&#x9;&#x9;&#x9;case 8:    titel = &quot;Lieferschein&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 82:   titel = &quot;Leistungsnachweis&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 7:  // Rechnung&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;switch (invoiceTypeBT3)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;326&quot;: titel = &quot;Teilrechnung&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;386&quot;: titel = &quot;Anzahlungsrechnung&quot;; break;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;380&quot;: titel = &quot;Rechnung&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;384&quot;: titel = &quot;Rechnungskorrektur&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;381&quot;: titel = &quot;Gutschrift&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;875&quot;: titel = &quot;Abschlagsrechnung&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;876&quot;: titel = &quot;Teilschlussrechnung&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;877&quot;: titel = &quot;Schlussrechnung&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;default:    titel = &quot;Rechnung&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;break;&#xD;&#xA;&#x9;&#x9;&#x9;case 81: titel = &quot;Rücklieferschein&quot;; break;  // Alte Logik von CR&#xD;&#xA;&#x9;&#x9;&#x9;case 9:  titel = &quot;Bestellung&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 10: titel = &quot;Anfrage&quot;; break;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;default: titel = &quot;Beleg&quot;; break;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;break;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;case 1: // Englisch&#xD;&#xA;&#x9;&#x9;switch (objType)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;case 4:    titel = &quot;Calculation&quot;; break;&#x9;    &#xD;&#xA;&#x9;&#x9;&#x9;case 6:    titel = &quot;Offer&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 5:    titel = &quot;Order confirmation&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 51:   titel = &quot;Proforma invoice&quot;; break;                 &#xD;&#xA;&#x9;&#x9;&#x9;case 8:    titel = &quot;Delivery note&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 82:   titel = &quot;Service Report&quot;; break;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;case 7:  &#xD;&#xA;&#x9;&#x9;&#x9;&#x9;switch (invoiceTypeBT3)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;326&quot;: titel = &quot;Partial invoice&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;386&quot;: titel = &quot;Down payment invoice&quot;; break;&#x9;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;380&quot;: titel = &quot;Invoice&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;384&quot;: titel = &quot;Invoice correction&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;381&quot;: titel = &quot;Credit note&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;875&quot;: titel = &quot;Advance invoice&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;876&quot;: titel = &quot;Partial final invoice&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;877&quot;: titel = &quot;Final invoice&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;default:    titel = &quot;Invoice&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;break;&#xD;&#xA;&#x9;&#x9;&#x9;case 81: titel = &quot;Return delivery note&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 9:  titel = &quot;Purchase order&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 10: titel = &quot;Inquiry&quot;; break;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;default: titel = &quot;Document&quot;; break;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;break;&#xD;&#xA;&#x9;&#xD;&#xA;&#x9;case 2: // Französisch&#xD;&#xA;&#x9;&#x9;switch (objType)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;        &#x9;&#x9;case 4:    titel = &quot;Calcul&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 6:    titel = &quot;Offre&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 5:    titel = &quot;Confirmation de commande&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 51:   titel = &quot;Facture pro forma&quot;; break;                 &#xD;&#xA;&#x9;&#x9;&#x9;case 8:    titel = &quot;Bon de livraison&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 82:   titel = &quot;Rapport de prestations&quot;; break;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;case 7:  &#xD;&#xA;&#x9;&#x9;&#x9;&#x9;switch (invoiceTypeBT3)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;326&quot;: titel = &quot;Facture partielle&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;386&quot;: titel = &quot;Facture d’acompte&quot;; break;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;380&quot;: titel = &quot;Facture&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;384&quot;: titel = &quot;Correction de facture&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;381&quot;: titel = &quot;Avoir&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;875&quot;: titel = &quot;Facture d’acompte&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;876&quot;: titel = &quot;Facture partielle finale&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;877&quot;: titel = &quot;Facture finale&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;default:    titel = &quot;Facture&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;break;&#xD;&#xA;&#x9;&#x9;&#x9;case 81: titel = &quot;Bon de retour&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 9:  titel = &quot;Bon de commande&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 10: titel = &quot;Demande&quot;; break;&#x9;  // Text angepasst&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;default: titel = &quot;Document&quot;; break;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;break;            &#xD;&#xA;&#xD;&#xA;&#x9;case 3: // Niederländisch&#xD;&#xA;&#x9;&#x9;switch (objType)&#xD;&#xA;&#x9;&#x9;{&#xD;&#xA;        &#x9;&#x9;case 4:    titel = &quot;Calculatie&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 6:    titel = &quot;Offerte&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 5:    titel = &quot;Proforma factuur&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 51:   titel = &quot;Facture pro forma&quot;; break;                 &#xD;&#xA;&#x9;&#x9;&#x9;case 8:    titel = &quot;Leveringsbon&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 82:   titel = &quot;Werkbon&quot;; break;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;case 7:  &#xD;&#xA;&#x9;&#x9;&#x9;&#x9;switch (invoiceTypeBT3)&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;{&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;326&quot;: titel = &quot;Gedeeltelijke factuur&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;386&quot;: titel = &quot;Aanbetalingsfactuur&quot;; break;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;380&quot;: titel = &quot;Factuur&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;384&quot;: titel = &quot;Correction de facture&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;381&quot;: titel = &quot;Factuurcorrectie&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;875&quot;: titel = &quot;Aanbetalingsfactuur&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;876&quot;: titel = &quot;Eindafrekening deelfactuur&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;case &quot;877&quot;: titel = &quot;Eindfactuur&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;default:    titel = &quot;Factuur&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;&#x9;&#x9;break;&#xD;&#xA;&#x9;&#x9;&#x9;case 81: titel = &quot;Nalevering&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 9:  titel = &quot;Opdracht&quot;; break;&#xD;&#xA;&#x9;&#x9;&#x9;case 10: titel = &quot;Aanvraag&quot;; break;&#x9;  // Text angepasst&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;&#x9;default: titel = &quot;Document&quot;; break;&#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;&#x9;&#x9;break;  &#xD;&#xA;        default:&#xD;&#xA;            titel = &quot;BELEG&quot;;&#xD;&#xA;            break;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    return string.Format(&quot;{0} {1}&quot;, titel.ToUpper(), nummer); //SET Groß/Kleinschreibung&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void tc_title_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    ((XRTableCell)sender).Text = GetTitelText();&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Folgeseite-Titel wird über lb_TitelFolgeseite_PrintOnPage ausgegeben (siehe unten).&#xD;&#xA;private void lb_TitelFolgeseite_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    XRLabel label = sender as XRLabel;&#xD;&#xA;&#xD;&#xA;    int currentPage = e.PageIndex + 1;&#xD;&#xA;    int totalPages = e.PageCount;&#xD;&#xA;&#xD;&#xA;    object rawDate = GetCurrentColumnValue(&quot;ERP_Datum&quot;);&#xD;&#xA;    string datum = &quot;&quot;;&#xD;&#xA;    if (rawDate is DateTime)&#xD;&#xA;        datum = ((DateTime)rawDate).ToString(&quot;dd.MM.yyyy&quot;);&#xD;&#xA;&#xD;&#xA;    string titel = GetTitelText();&#xD;&#xA;&#xD;&#xA;    int sprachCode = ToIntSafe(GetCurrentColumnValue(&quot;_SprachCodeERP&quot;), 0);&#xD;&#xA;    &#xD;&#xA;    switch (sprachCode)&#xD;&#xA;    {&#xD;&#xA;        case 1: // Englisch&#xD;&#xA;            label.Text = string.Format(&quot;{0} from {1}, page {2} of {3}&quot;, titel, datum, currentPage, totalPages);&#xD;&#xA;            break;&#xD;&#xA;        case 2: // Französisch&#xD;&#xA;            label.Text = string.Format(&quot;{0} du {1}, page {2} de {3}&quot;, titel, datum, currentPage, totalPages);&#xD;&#xA;            break;&#xD;&#xA;        case 3: // Niederländisch&#xD;&#xA;            label.Text = string.Format(&quot;{0} van {1}, pagina {2} van {3}&quot;, titel, datum, currentPage, totalPages);&#xD;&#xA;            break;&#xD;&#xA;        default:&#xD;&#xA;            label.Text = string.Format(&quot;{0} vom {1}, Seite {2} von {3}&quot;, titel, datum, currentPage, totalPages);&#xD;&#xA;            break;&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// Detail-Sektion - entspricht Berechnungslogik pro Position in CrystalReports&#xD;&#xA;private void Detail_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e)&#xD;&#xA;{&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        &#xD;&#xA;        // Lizenzartikel mit Artikel-Hauptgruppe mit Code = 505172731&quot;&#xD;&#xA;        object codeObj = GetCurrentColumnValue(&quot;ARTIKELHauptgr_HauptgruppenCode&quot;);&#xD;&#xA;        int code;&#xD;&#xA;             &#xD;&#xA;        if (codeObj != null &amp;&amp; int.TryParse(codeObj.ToString(), out code) &amp;&amp; code == 505172731)&#xD;&#xA;        {&#xD;&#xA;            Lizenz++;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;         // Artikel mit Obergruppe Server-Hosting&#xD;&#xA;        object obergruppeObj = GetCurrentColumnValue(&quot;ARTIKELGr_Obergruppe&quot;);&#xD;&#xA;        string obergruppe = obergruppeObj != null ? Convert.ToString(obergruppeObj).Trim() : &quot;&quot;;&#xD;&#xA;        if (obergruppe == &quot;Server-Hosting&quot;)&#xD;&#xA;        {&#xD;&#xA;            ArtikelServerHosting++;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        // Auswertung StattGPreis: hat bis jetzt in allen Fällen funktioniert&#xD;&#xA;        object anzahlObj = GetCurrentColumnValue(&quot;POS_Anzahl&quot;);&#xD;&#xA;        object frei3Obj = GetCurrentColumnValue(&quot;POS_Frei3&quot;);&#xD;&#xA;        &#xD;&#xA;        &#xD;&#xA;        if (anzahlObj != null &amp;&amp; frei3Obj != null)&#xD;&#xA;        {&#xD;&#xA;            string frei3 = frei3Obj.ToString().Trim();&#xD;&#xA;            string anzahlStr = anzahlObj.ToString().Replace(&quot;,&quot;, &quot;.&quot;); // falls Komma statt Punkt&#xD;&#xA;        &#xD;&#xA;            decimal anzahl = 0;&#xD;&#xA;            try&#xD;&#xA;            {&#xD;&#xA;                anzahl = Convert.ToDecimal(anzahlStr, System.Globalization.CultureInfo.InvariantCulture);&#xD;&#xA;            }&#xD;&#xA;            catch&#xD;&#xA;            {&#xD;&#xA;                // Zahl ungültig → weiter mit 0&#xD;&#xA;            }&#xD;&#xA;        &#xD;&#xA;            if (!string.IsNullOrWhiteSpace(frei3) &amp;&amp; anzahl &gt; 1)&#xD;&#xA;            {&#xD;&#xA;                frei3Counter++;&#xD;&#xA;            }&#xD;&#xA;        } &#xD;&#xA;        &#xD;&#xA;        // ArtikelArt&#xD;&#xA;        object artikelArtObj = GetCurrentColumnValue(&quot;POS_ArtikelArt&quot;);&#xD;&#xA;        string artikelArt = artikelArtObj != null ? Convert.ToString(artikelArtObj).Trim() : &quot;&quot;;&#xD;&#xA;&#xD;&#xA;        switch (artikelArt)&#xD;&#xA;        {&#xD;&#xA;            case &quot;-3&quot;:&#xD;&#xA;                titelsumme = 0;&#xD;&#xA;                break;&#xD;&#xA;            case &quot;-13&quot;:&#xD;&#xA;                zwischensumme = 0;&#xD;&#xA;                break;&#xD;&#xA;        }&#xD;&#xA;&#xD;&#xA;        // Seitenumbruch&#xD;&#xA;        Detail.PageBreak = artikelArt == &quot;-4&quot;&#xD;&#xA;            ? DevExpress.XtraReports.UI.PageBreak.BeforeBand&#xD;&#xA;            : DevExpress.XtraReports.UI.PageBreak.None;&#xD;&#xA;        &#xD;&#xA;    }&#xD;&#xA;    catch&#xD;&#xA;    {&#xD;&#xA;        // Optional: log or inspect ex.Message&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// GPreis und StattGPreis ====================================================&#xD;&#xA;private void tc_GPreis_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;&#xD;&#xA;    XRTableCell cell = sender as XRTableCell;&#xD;&#xA;&#xD;&#xA;    object artikelArtObj = GetCurrentColumnValue(&quot;POS_ArtikelArt&quot;);&#xD;&#xA;    if (artikelArtObj == null)&#xD;&#xA;    {&#xD;&#xA;        cell.Text = string.Empty;&#xD;&#xA;        return;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    int objType = ToIntSafe(GetCurrentColumnValue(&quot;ERP_BZObjType&quot;), 0);&#xD;&#xA;    int artikelArt = ToIntSafe(artikelArtObj, 0);&#xD;&#xA;    decimal gesPreis = ToDecimalSafe(GetCurrentColumnValue(&quot;POS_GesPreis&quot;));&#xD;&#xA;    decimal stattGPreis = ToDecimalSafe(GetCurrentColumnValue(&quot;calcStattGPreis&quot;));&#xD;&#xA;    string frei3 = ToStringSafe(GetCurrentColumnValue(&quot;POS_Frei3&quot;));&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;    // ---- Spezialfall ----&#xD;&#xA;    // Wenn ObjType = 8, nur Frei3 anzeigen (falls vorhanden), sonst leer&#xD;&#xA;    if (objType == 8)&#xD;&#xA;    {&#xD;&#xA;        cell.Text = string.IsNullOrWhiteSpace(frei3) ? string.Empty : frei3;&#xD;&#xA;        return;&#xD;&#xA;    }&#xD;&#xA;    &#xD;&#xA;    // ---- Hauptlogik ----&#xD;&#xA;    switch (artikelArt)&#xD;&#xA;    {&#xD;&#xA;        case 0:   // normalern Artikel&#xD;&#xA;        case -8:  // Excel-Artikel&#xD;&#xA;        case -10: // Stücklistenkopf&#xD;&#xA;        case -20:&#xD;&#xA;        case -21:&#xD;&#xA;        case -24: // System-Stückliste aus Projektzeitabrechnung &#xD;&#xA;            if (!string.IsNullOrWhiteSpace(frei3))&#xD;&#xA;            {&#xD;&#xA;&#x9;&#x9;    decimal anzahl = ToDecimalSafe(GetCurrentColumnValue(&quot;POS_Anzahl&quot;));&#xD;&#xA;&#x9;&#x9;&#x9;&#xD;&#xA;&#x9;&#x9;    if (anzahl == 1)&#xD;&#xA;&#x9;&#x9;    {&#xD;&#xA;&#x9;&#x9;&#x9;    // Nur Freitext anzeigen (keine Preisangabe, kein Zeilenumbruch)&#xD;&#xA;&#x9;&#x9;&#x9;    cell.Text = frei3;&#xD;&#xA;&#x9;&#x9;    }&#xD;&#xA;&#x9;&#x9;    else&#xD;&#xA;&#x9;&#x9;    {&#xD;&#xA;&#x9;&#x9;&#x9;    // Stattpreis + Zeilenumbruch + Freitext&#xD;&#xA;&#x9;&#x9;&#x9;    cell.Text = string.Format(&quot;({0:N2}){1}{2}&quot;, stattGPreis, Environment.NewLine, frei3);&#xD;&#xA;&#x9;&#x9;    }            &#xD;&#xA;&#x9;&#x9;}&#xD;&#xA;            else if (gesPreis == 0 &amp;&amp; stattGPreis == 0)&#xD;&#xA;            {&#xD;&#xA;                cell.Text = string.Empty;&#xD;&#xA;            }&#x9;&#xD;&#xA;            else&#xD;&#xA;            {&#xD;&#xA;                // normaler Preis&#xD;&#xA;                cell.Text = string.Format(&quot;{0:N2}&quot;, gesPreis);&#xD;&#xA;            }&#xD;&#xA;            break;&#xD;&#xA;&#xD;&#xA;        case -2: // Titelsumme&#xD;&#xA;            cell.Text = titelsumme == 0 ? string.Empty : titelsumme.ToString(&quot;N2&quot;);&#xD;&#xA;            break;&#xD;&#xA;&#xD;&#xA;        case -12: // Zwischensumme&#xD;&#xA;            cell.Text = zwischensumme == 0 ? string.Empty : zwischensumme.ToString(&quot;N2&quot;);&#xD;&#xA;            break;&#xD;&#xA;&#xD;&#xA;        default:&#xD;&#xA;            cell.Text = string.Empty;&#xD;&#xA;            break;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Markiert, dass der Detailbereich (Sub_POS) auf mindestens einer Seite tatsächlich zu drucken begonnen hat.&#xD;&#xA;// Feuert für jede Zeile unabhängig von ArtikelArt (Titel, Historie, normale Position, ...) - entscheidend ist&#xD;&#xA;// nur, dass der Detailbereich selbst begonnen hat, nicht ob die konkrete Zeile einen Preis trägt. Siehe die&#xD;&#xA;// Erklärung bei _detailPrintedSoFar oben sowie den Kommentar über &quot;Übertrag Unterdrückungslogik&quot; weiter unten.&#xD;&#xA;private void tc_GPreis_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    _detailPrintedSoFar = true;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Titel- und Zwischensumme kaufmännisch runden (AwayFromZero)&#xD;&#xA;private void Detail_AfterPrint(object sender, System.EventArgs e)&#xD;&#xA;{&#xD;&#xA;    object value = GetCurrentColumnValue(&quot;POS_GesPreis&quot;);&#xD;&#xA;&#xD;&#xA;    if (value != null)&#xD;&#xA;    {&#xD;&#xA;        decimal val = Math.Round(&#xD;&#xA;            ToDecimalSafe(value),&#xD;&#xA;            2,&#xD;&#xA;            MidpointRounding.AwayFromZero&#xD;&#xA;        );&#xD;&#xA;&#xD;&#xA;        titelsumme += val;&#xD;&#xA;        zwischensumme += val;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Set Background Color of TableCell ====================================================&#xD;&#xA;private void xrCellSLinfo_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    XRTableCell cell = (XRTableCell)sender;&#xD;&#xA;    // exact RGB value&#xD;&#xA;    cell.BackColor = System.Drawing.Color.FromArgb(218, 227, 243);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;// Ab hier SICHTBARKEITS bzw. UNTERDRÜCKUNGSLOGIKEN&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;&#xD;&#xA;// Seitenzähler-Logik ***********************************************************************************************&#xD;&#xA;private void PageFooter_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    ++pageCounter;&#xD;&#xA;   &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Hinweis: Frühere experimentelle Handler (lb_Counter_PrintOnPage, lb_Pg_Counter_PrintOnPage,&#xD;&#xA;// lb_Counter_BeforePrint) wurden entfernt. Sie waren nicht mehr mit Controls im Report verbunden&#xD;&#xA;// (verwaister/toter Code aus früheren Versuchen, die aktuelle Seite in BeforePrint zu ermitteln)&#xD;&#xA;// und mutierten nebenbei unkontrolliert Sub_Bezug_Folgeseiten.Visible. Die aktuell aktive,&#xD;&#xA;// verlässliche Lösung für &quot;auf welcher Seite bin ich?&quot; ist ausschließlich PrintOnPage + e.PageIndex,&#xD;&#xA;// siehe Abschnitt &quot;Übertrag Unterdrückungslogik&quot; weiter unten.&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// ERP-Titel der Folgeseite auf Seite 1 unterdrücken&#xD;&#xA;private void Sub_Bezug_Folgeseiten_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    if (pageCounter == 1) // erste Seite&#xD;&#xA;    {&#xD;&#xA;        e.Cancel = true; // Band vollständig ausblenden, kein Platz&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Überschriften der Tabelle - Unterdrückungslogik ====================================================&#xD;&#xA;// Der frühere BeforePrint-Handler dieser Subband (Sub_POS_Ueberschriften_Folgeseiten_BeforePrint,&#xD;&#xA;// Bedingung &quot;pageCounter == 1&quot;) wurde entfernt. Er hat die komplette Subband unabhängig vom&#xD;&#xA;// tatsächlichen Seiteninhalt abgeschaltet, sobald der grobe globale pageCounter den Wert 1 erreichte&#xD;&#xA;// (per Definition NUR bei exakt der zweiten Seite - ab der dritten Folgeseite griff er ohnehin nicht&#xD;&#xA;// mehr) - und zwar VOR den PrintOnPage-Ereignissen der enthaltenen Controls. Dadurch konnte&#xD;&#xA;// lblCarryHelperOben (siehe unten) auf genau den betroffenen Seiten nie feuern und _carryObenByPage&#xD;&#xA;// blieb leer, was wiederum dazu führte, dass auf einer echten Folgeseite (z. B. wenn ein langer&#xD;&#xA;// Kopftext die erste Position mit Preis komplett auf Seite 2 verschiebt) die Tabellenüberschriften&#xD;&#xA;// fälschlich unterdrückt wurden. Die Sichtbarkeit wird jetzt ausschließlich über die verlässlichere,&#xD;&#xA;// bereits vorhandene PrintOnPage-Logik von tb_Überschriften_Folgeseite (siehe &quot;Übertrag&#xD;&#xA;// Unterdrückungslogik&quot; weiter unten) gesteuert, die pro physischer Seite den tatsächlichen&#xD;&#xA;// Übertragswert bzw. die Gesamtsumme des Belegs auswertet statt eines groben Seitenzählers.&#xD;&#xA;&#xD;&#xA;// Adresse zusätzlicher Abstand ====================================================&#xD;&#xA;private void Sub_AbstandSeite1_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;   if (pageCounter != 1) { // 1 = Space only for first page&#xD;&#xA;        e.Cancel = true; // Prevents the sub from rendering&#xD;&#xA;    }       &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Hinweis zu StattGPreis Artikel nicht anzeigen&#xD;&#xA;private void Sub_InfoStattGPreis_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;&#xD;&#xA;    if (frei3Counter == 0) {&#xD;&#xA;        e.Cancel = true; // Hide control&#xD;&#xA;    }     &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Uebertrag unten nicht anzeigen (nur auf der letzten Seite, dort stehen die echten Endsummen).&#xD;&#xA;// GroupFooter_Uebertrag wird hier bewusst per Script-Mutation ausgeblendet statt über eine&#xD;&#xA;// Visible-Expression direkt am Band. Live-Test: GroupFooter_Uebertrag wurde korrekt ausgeblendet.&#xD;&#xA;// Bekannte, bisher ungelöste Einschränkung: fällt GroupFooter_Summen exakt auf einen Seitenumbruch,&#xD;&#xA;// fehlt der Übertrag. Diese Verdrahtung bewusst NICHT verändert - siehe Kommentar bei&#xD;&#xA;// GROUP_ERP_Nummer_BeforePrint für die Ergänzung, die den Batch-Druck-Fall absichert.&#xD;&#xA;private void GroupFooter_Summen_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    GroupFooter_Uebertrag.Visible = false;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Übertrag Unterdrückungslogik ====================================================&#xD;&#xA;// Robustheits-Hinweis: Alle Sichtbarkeits-Entscheidungen zum Übertrag (oben/unten) und zu den&#xD;&#xA;// Tabellenüberschriften der Folgeseite laufen bewusst ausschließlich über PrintOnPage-Ereignisse&#xD;&#xA;// (e.PageIndex ist erst dort zuverlässig verfügbar, siehe DevExpress-Doku zu BeforePrint vs.&#xD;&#xA;// PrintOnPage) und werden zusätzlich zur seitenbezogenen Carryover-Summe (sumCarryoverSum, über&#xD;&#xA;// _carryObenByPage zwischengespeichert), zur Gesamtsumme des kompletten Belegs (_docGesamtGesPreis,&#xD;&#xA;// aus [calcSumGesPreis]) UND zum Flag _detailPrintedSoFar (siehe tc_GPreis_PrintOnPage) abgesichert.&#xD;&#xA;// Dadurch wird zwischen drei Fällen unterschieden, die zuvor teils identisch (und falsch) behandelt&#xD;&#xA;// wurden:&#xD;&#xA;//  - Der Beleg enthält insgesamt gar keine Position mit Preis (nur Titel/Historie) -&gt; Übertrag&#xD;&#xA;//    bleibt unterdrückt, wie in den fachlichen Vorgaben gefordert (_docGesamtGesPreis bleibt 0).&#xD;&#xA;//  - Der Beleg enthält Positionen mit Preis, der Detailbereich (Sub_POS) hat auf einer früheren&#xD;&#xA;//    Seite bereits begonnen, aber auf der aktuellen Seite ist bislang (z. B. weil eine Position mit&#xD;&#xA;//    Preis über den Seitenumbruch verschoben wurde) noch keine Position mit Preis gedruckt worden&#xD;&#xA;//    -&gt; Übertrag wird trotzdem angezeigt (ggf. als 0,00), statt fälschlich ausgeblendet zu werden.&#xD;&#xA;//  - Der Detailbereich (Sub_POS) hat auf DIESER Seite noch gar nicht begonnen, weil vorgelagerter&#xD;&#xA;//    Inhalt (sehr langer Kopftext, oder die über ArgShowTitleOverview gesteuerte Titelübersicht&#xD;&#xA;//    Sub_Titelsummen inkl. Belegrabatt/Belegzuschlag) die Seite vollständig einnimmt bzw. selbst über&#xD;&#xA;//    mehrere Seiten geht -&gt; Übertrag bleibt unterdrückt (_detailPrintedSoFar ist noch false), auch&#xD;&#xA;//    wenn der Beleg insgesamt einen Betrag hat. Erst sobald die erste echte Sub_POS-Zeile gedruckt&#xD;&#xA;//    wurde, darf Übertrag/Folgeseiten-Titel auf einer nachfolgenden Seite erscheinen.&#xD;&#xA;&#xD;&#xA;// Hilfsfunktion&#xD;&#xA;decimal GetCarryObenForPage(int pageIndex) {&#xD;&#xA;    if (_carryObenByPage.ContainsKey(pageIndex))&#xD;&#xA;        return ToDecimalSafe(_carryObenByPage[pageIndex]);&#xD;&#xA;    return 0m;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Debugging&#xD;&#xA;string _dbgHelper = &quot;&quot;;&#xD;&#xA;private void lblDebug_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    lblDebug.Text = _dbgHelper;}&#xD;&#xA;&#xD;&#xA;// Hilfsvariabel um Übertragswerte zu speichern&#xD;&#xA;System.Collections.Hashtable _carryObenByPage = new System.Collections.Hashtable();&#xD;&#xA;&#xD;&#xA;private void lblCarryHelperOben_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    var lbl = (DevExpress.XtraReports.UI.XRLabel)sender;&#xD;&#xA;    _carryObenByPage[e.PageIndex] = ToDecimalSafe(lbl.Text);&#xD;&#xA;&#xD;&#xA;    // Test-Ausgabe:&#xD;&#xA;    _dbgHelper = string.Format(&#xD;&#xA;    &quot;P={0} HelperText=[{1}]&quot;,&#xD;&#xA;    e.PageIndex + 1,&#xD;&#xA;    lbl.Text&#xD;&#xA;    );&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Erfasst [calcSumGesPreis] (Gesamtsumme des kompletten Belegs, seitenunabhängig) in die globale&#xD;&#xA;// Variable _docGesamtGesPreis. Feuert auf jeder Seite gemeinsam mit lblCarryHelperOben; da der Wert&#xD;&#xA;// über den gesamten Beleg konstant ist, genügt es, dass er spätestens vor der Übertrag-Fußzeile von&#xD;&#xA;// Seite 1 einmal erfasst wurde.&#xD;&#xA;private void lblDocGesamtGesPreis_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    var lbl = (DevExpress.XtraReports.UI.XRLabel)sender;&#xD;&#xA;    _docGesamtGesPreis = ToDecimalSafe(lbl.Text);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void tb_Überschriften_Folgeseite_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    decimal carry = GetCarryObenForPage(e.PageIndex);&#xD;&#xA;&#xD;&#xA;    bool show = (e.PageIndex != 0) &amp;&amp; _detailPrintedSoFar &amp;&amp; (carry != 0m || _docGesamtGesPreis != 0m);&#xD;&#xA;&#xD;&#xA;    if (!show)&#xD;&#xA;        e.Cancel = true;  // Tabelle wird auf dieser Seite gar nicht gedruckt&#xD;&#xA;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void tb_ÜbertragOben_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    decimal carry = GetCarryObenForPage(e.PageIndex);&#xD;&#xA;&#xD;&#xA;    bool show = (e.PageIndex != 0) &amp;&amp; _detailPrintedSoFar &amp;&amp; (carry != 0m || _docGesamtGesPreis != 0m);&#xD;&#xA;&#xD;&#xA;    if (!show)&#xD;&#xA;        e.Cancel = true;  // Tabelle wird auf dieser Seite gar nicht gedruckt&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;private void lblCarryHelperUnten_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    _carryValueUnten = ToDecimalSafe(lblCarryHelperUnten.Text);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void tb_ÜbertragUnten_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    var tbl = (DevExpress.XtraReports.UI.XRTable)sender;&#xD;&#xA;    tbl.Visible = _detailPrintedSoFar &amp;&amp; (_carryValueUnten != 0m || _docGesamtGesPreis != 0m);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;// Footer&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;&#xD;&#xA;// Footer (w4a Sonderlogik auf der letzten Seite unterdrücken, da hier die AGB angedruckt werden) ================================&#xD;&#xA;private void tblFooter_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    int bzObjType = ToIntSafe(GetParamSafe(&quot;BzObjType&quot;), 0);  // Checking BzObjType via Parameter&#xD;&#xA;    bool condition = (bzObjType == 5 || bzObjType == 6);&#xD;&#xA;&#xD;&#xA;    if (false)  //Im Standard gibt kein AGB, daher diese Logik erstmal deaktiviert&#xD;&#xA;    {&#xD;&#xA;        tblFooter.Visible = e.PageIndex &lt; (PrintingSystem.PageCount - 1);&#xD;&#xA;    }    &#xD;&#xA;    else&#xD;&#xA;    {&#xD;&#xA;        tblFooter.Visible = true;&#xD;&#xA;    }   &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void lb_FooterFirmenNameEtc_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    int bzObjType = ToIntSafe(GetParamSafe(&quot;BzObjType&quot;), 0);&#xD;&#xA;    bool isAngebotOderAuftrag = (bzObjType == 5 || bzObjType == 6);&#xD;&#xA;    bool isLastPage = e.PageIndex == (PrintingSystem.PageCount - 1);&#xD;&#xA;&#xD;&#xA;    // Logik: Nur unterdrücken bei Angebot/Auftrag UND letzter Seite&#xD;&#xA;    lb_FooterFirmenNameEtc.Visible = !(isAngebotOderAuftrag &amp;&amp; isLastPage);   &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Setzt GroupFooter_Uebertrag beim Start JEDES Belegs (Gruppenöffnung) wieder auf sichtbar zurück.&#xD;&#xA;// Hintergrund: GroupFooter_Summen_BeforePrint (siehe oben) schaltet dieses Band am Ende eines&#xD;&#xA;// Belegs dauerhaft auf Visible = false, indem direkt die Band-Eigenschaft mutiert wird (kein&#xD;&#xA;// Expression-Binding). Ohne diesen Reset würde bei einem Reportlauf mit mehreren Belegen in einem&#xD;&#xA;// Batch (z. B. Sammeldruck) der Übertrag im zweiten und jedem weiteren Beleg fälschlich unterdrückt&#xD;&#xA;// bleiben, weil der Visible-Zustand des ersten Belegs sonst bestehen bliebe.&#xD;&#xA;//&#xD;&#xA;// _detailPrintedSoFar wird hier aus Konsistenzgründen ebenfalls zurückgesetzt. Hinweis zur Grenze&#xD;&#xA;// dieses Resets: BeforePrint-Ereignisse laufen alle in der Generierungsphase, bevor die PrintOnPage-&#xD;&#xA;// Phase (in der _detailPrintedSoFar tatsächlich gelesen/gesetzt wird) für das gesamte Dokument&#xD;&#xA;// beginnt. Bei einem einzelnen Beleg pro Reportlauf (Normalfall) ist das unkritisch. Wird jedoch in&#xD;&#xA;// einem einzigen Lauf über mehrere Belege hinweg gedruckt (echter Sammeldruck mit mehreren Gruppen im&#xD;&#xA;// selben PrintingSystem), kann dieser Reset zu spät greifen - das ist dieselbe grundsätzliche Grenze,&#xD;&#xA;// die auch für _docGesamtGesPreis gilt (ebenfalls nicht pro Beleg zurückgesetzt). Bitte bei Bedarf für&#xD;&#xA;// Sammeldruck-Szenarien gesondert mit Testdaten prüfen.&#xD;&#xA;private void GROUP_ERP_Nummer_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    GroupFooter_Uebertrag.Visible = true;&#xD;&#xA;    _detailPrintedSoFar = false;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;// Skontoberechnungslogik&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;&#xD;&#xA;// GesamtbetragProPosition wird über ein NichtSichtbares Feld im Report im Expression GetValue Event berechnet&#xD;&#xA;// Dieser Wert wird für die Berechnung des Zahlbetrags in den Expressions von den Skonto-Labels benötigt&#xD;&#xA;private void calcSumGesamtBrutto_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;    object preisObj = GetCurrentColumnValue(&quot;POS_GesPreis&quot;);&#xD;&#xA;    decimal preis = ToDecimalSafe(preisObj);&#xD;&#xA;&#xD;&#xA;    object mwstObj = GetCurrentColumnValue(&quot;POS_Mwst&quot;);&#xD;&#xA;    decimal mwst = ToDecimalSafe(mwstObj);&#xD;&#xA;&#xD;&#xA;    decimal brutto = preis + (preis * (mwst / 100m));&#xD;&#xA;    e.Value = brutto;    &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// SkontoProPosition wird über ein NichtSichtbares Feld im Report im Expression GetValue Event berechnet&#xD;&#xA;// Dieser Wert wird für die Berechnung des Zahlbetrags in den Expressions von den Skonto-Labels benötigt&#xD;&#xA;private void calcSumSkontoPosBetrag_GetValue(object sender, DevExpress.XtraReports.UI.GetValueEventArgs e) {&#xD;&#xA;    object preisObj = GetCurrentColumnValue(&quot;POS_GesPreis&quot;);&#xD;&#xA;    decimal preis = ToDecimalSafe(preisObj);&#xD;&#xA;&#xD;&#xA;    object mwstObj = GetCurrentColumnValue(&quot;POS_Mwst&quot;);&#xD;&#xA;    decimal mwst = ToDecimalSafe(mwstObj);&#xD;&#xA;&#xD;&#xA;    object skontoObj = GetCurrentColumnValue(&quot;ERP_SkontoProzent&quot;);&#xD;&#xA;    decimal skonto = ToDecimalSafe(skontoObj);&#xD;&#xA;&#xD;&#xA;    object skontoFObj = GetCurrentColumnValue(&quot;ARTIKEL_NichtSkontofähig&quot;);&#xD;&#xA;    bool nichtSkontofaehig = ToBoolSafe(skontoFObj, false);&#xD;&#xA;&#xD;&#xA;    decimal brutto = preis + (preis * mwst / 100m);&#xD;&#xA;    e.Value = (!nichtSkontofaehig &amp;&amp; skonto != 0m) ? brutto * skonto / 100m : 0m;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// SkontoText über Expression gelöst (Problem bei BeforePrint: Skonto-Summe steht dort noch nicht zur Verfügung).&#xD;&#xA;// Übersetzung von lblEKTO_4a_Drittland_4_1a nach Localization verlegt.&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;// Platzierungslogiken&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;&#xD;&#xA;// Rechnungsadresse-Titel: Platzierung links, wenn es keine abweichende Lieferadresse gibt ===================&#xD;&#xA;private void lblRechnungsAdrTitel_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    bool condition = (ToIntSafe(GetCurrentColumnValue(&quot;BzObjType&quot;), 0) != 8) &amp;&amp; //Checking BzObjType via ERP-Feld, alternativ siehe Script zu AGB-Visible&#xD;&#xA;                     Equals(GetCurrentColumnValue(&quot;ERP_Hauptadresse&quot;), GetCurrentColumnValue(&quot;ERP_NebenAdrText1&quot;));&#xD;&#xA;    if (condition)&#xD;&#xA;    {&#xD;&#xA;        lblRechnungsAdrTitel.LocationF = new PointF(200f, lblRechnungsAdrTitel.LocationF.Y); // Move right&#xD;&#xA;    }&#xD;&#xA;    else&#xD;&#xA;    {&#xD;&#xA;        lblRechnungsAdrTitel.LocationF = new PointF(1220f, 50f); // Default position&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Rechnungsadresse: Platzierung links, wenn es keine abweichende Lieferadresse gibt ===================&#xD;&#xA;private void lblRechnungAdrAusgabe_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    bool condition = (ToIntSafe(GetCurrentColumnValue(&quot;BzObjType&quot;), 0) != 8) &amp;&amp;&#xD;&#xA;                     Equals(GetCurrentColumnValue(&quot;ERP_Hauptadresse&quot;), GetCurrentColumnValue(&quot;ERP_NebenAdrText1&quot;));&#xD;&#xA;    if (condition)&#xD;&#xA;    {&#xD;&#xA;        lblRechnungAdrAusgabe.LocationF = new PointF(200f, lblRechnungAdrAusgabe.LocationF.Y); // Move right&#xD;&#xA;    }&#xD;&#xA;    else&#xD;&#xA;    {&#xD;&#xA;        lblRechnungAdrAusgabe.LocationF = new PointF(1220f, 100f); // Default position&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Set Font Color of Label via Code&#xD;&#xA;private void tblFooterFirmenNameEtc_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;&#xD;&#xA;    var label = (DevExpress.XtraReports.UI.XRLabel)sender;&#xD;&#xA;&#xD;&#xA;    // let this script override any style color&#xD;&#xA;    label.StylePriority.UseForeColor = false;&#xD;&#xA;&#xD;&#xA;    // RGB text color&#xD;&#xA;    label.ForeColor = System.Drawing.Color.FromArgb(0,15,99);  //RGB mit Paint.net aus w4a PDF extrahiert&#xD;&#xA;}   &#xD;&#xA;&#xD;&#xA;private float MmToReportUnits(float mm)&#xD;&#xA;{&#xD;&#xA;    return (mm / 25.4f) * 100f;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Prüft, ob ein Parameterwert ein gültiger Base64-String ist.&#xD;&#xA;// Wird z. B. für dynamische Logos verwendet, damit ungültige oder leere Bilddaten&#xD;&#xA;// keine FormatException beim Rendern des Reports auslösen.&#xD;&#xA;private bool IsValidBase64(object value)&#xD;&#xA;{&#xD;&#xA;    if (value == null || value == DBNull.Value)&#xD;&#xA;        return false;&#xD;&#xA;&#xD;&#xA;    string text = Convert.ToString(value);&#xD;&#xA;    if (string.IsNullOrWhiteSpace(text))&#xD;&#xA;        return false;&#xD;&#xA;&#xD;&#xA;    text = text.Trim();&#xD;&#xA;&#xD;&#xA;    // Quick rejects for common sentinel values&#xD;&#xA;    if (text.Length == 1 &amp;&amp; text == &quot;0&quot;) return false;&#xD;&#xA;    if (text.Equals(&quot;false&quot;, StringComparison.OrdinalIgnoreCase) ||&#xD;&#xA;        text.Equals(&quot;null&quot;, StringComparison.OrdinalIgnoreCase)) return false;&#xD;&#xA;&#xD;&#xA;    // Remove whitespace/newlines that might be included&#xD;&#xA;    string compact = System.Text.RegularExpressions.Regex.Replace(text, @&quot;\s+&quot;, &quot;&quot;);&#xD;&#xA;&#xD;&#xA;    // Length of base64 (with padding) must be multiple of 4&#xD;&#xA;    if (compact.Length % 4 != 0)&#xD;&#xA;        return false;&#xD;&#xA;&#xD;&#xA;    // Allowed Base64 chars (standard alphabet) and up to two '=' padding chars&#xD;&#xA;    if (!System.Text.RegularExpressions.Regex.IsMatch(compact, @&quot;^[A-Za-z0-9\+/]*={0,2}$&quot;))&#xD;&#xA;        return false;&#xD;&#xA;&#xD;&#xA;    // Final attempt: still wrapped to be safe (rare)&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        Convert.FromBase64String(compact);&#xD;&#xA;        return true;&#xD;&#xA;    }&#xD;&#xA;    catch (FormatException)&#xD;&#xA;    {&#xD;&#xA;        return false;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;// Diese Funktion steuert das Logo in der Kopfzeile über x,y Koordinaten-Parameter&#xD;&#xA;// Default fallback values&#xD;&#xA;// https://www.1a-studi.de/din-5008/geschaeftsbrief&#xD;&#xA;private void xrPictureBox_CustomLogo1_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e)&#xD;&#xA;{&#xD;&#xA;    // Das auslösende Control ist die PictureBox, die vor dem Drucken/Rendern angepasst wird.&#xD;&#xA;    XRPictureBox box = (XRPictureBox)sender;&#xD;&#xA;&#xD;&#xA;    // Zielkoordinaten für die spätere Position des Bildes innerhalb des Reports.&#xD;&#xA;    // Diese Werte müssen am Ende in der Report-Einheit vorliegen&#xD;&#xA;    // (z. B. Zehntel-Millimeter oder Hundertstel-Zoll).&#xD;&#xA;    float x = 0f;&#xD;&#xA;    float y = 0f;&#xD;&#xA;&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        // Die Parameterwerte werden als String gelesen.&#xD;&#xA;        // In deinem Fall kommen die Positionswerte z. B. als &quot;200.0&quot; an.&#xD;&#xA;        string sx = Convert.ToString(Parameters[&quot;Settings_Logo1PosX&quot;].Value);&#xD;&#xA;        string sy = Convert.ToString(Parameters[&quot;Settings_Logo1PosY&quot;].Value);&#xD;&#xA;&#xD;&#xA;        // Diese Variablen enthalten die eingelesenen Werte zunächst in Millimeter.&#xD;&#xA;        // Beispiel:&#xD;&#xA;        // Eingabe &quot;200.0&quot; bedeutet 200 mm.&#xD;&#xA;        float mmX = 0f;&#xD;&#xA;        float mmY = 0f;&#xD;&#xA;&#xD;&#xA;        // Normalisierung des Dezimaltrennzeichens:&#xD;&#xA;        // Manche Eingaben können &quot;200,0&quot; statt &quot;200.0&quot; enthalten.&#xD;&#xA;        // Durch Ersetzen von ',' durch '.' wird eine einheitliche Form erzeugt,&#xD;&#xA;        // die anschließend mit InvariantCulture sicher geparst werden kann.&#xD;&#xA;        if (sx != null) sx = sx.Replace(',', '.');&#xD;&#xA;        if (sy != null) sy = sy.Replace(',', '.');&#xD;&#xA;&#xD;&#xA;        // Kulturunabhängiges Parsen der Strings in Float-Werte.&#xD;&#xA;        //&#xD;&#xA;        // Warum ist das notwendig?&#xD;&#xA;        // Die Parameter kommen als String an, z. B. &quot;200.0&quot;.&#xD;&#xA;        // Wenn man Convert.ToSingle(...) verwendet, wird die aktuelle UI-/Thread-Culture benutzt.&#xD;&#xA;        // Dadurch kann derselbe Text je nach Sprache unterschiedlich interpretiert werden.&#xD;&#xA;        //&#xD;&#xA;        // Problemfall:&#xD;&#xA;        // - EN-Culture interpretiert &quot;200.0&quot; korrekt als 200&#xD;&#xA;        // - DE-Culture kann &quot;200.0&quot; anders interpretieren, weil '.' dort nicht das normale Dezimaltrennzeichen ist&#xD;&#xA;        //&#xD;&#xA;        // Mit InvariantCulture wird &quot;200.0&quot; immer stabil als 200 gelesen.&#xD;&#xA;        float.TryParse(&#xD;&#xA;            sx,&#xD;&#xA;            System.Globalization.NumberStyles.Float,&#xD;&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;            out mmX&#xD;&#xA;        );&#xD;&#xA;&#xD;&#xA;        float.TryParse(&#xD;&#xA;            sy,&#xD;&#xA;            System.Globalization.NumberStyles.Float,&#xD;&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;            out mmY&#xD;&#xA;        );&#xD;&#xA;&#xD;&#xA;        // Umrechnung von Millimeter in die interne Report-Einheit.&#xD;&#xA;        //&#xD;&#xA;        // Wichtig:&#xD;&#xA;        // Die Eingabeparameter sind fachlich als Millimeter zu verstehen.&#xD;&#xA;        // LocationF erwartet aber keine Millimeter, sondern die Einheit des Reports.&#xD;&#xA;        //&#xD;&#xA;        // Typischer Problemfall:&#xD;&#xA;        // - Benutzer gibt 200 ein und erwartet 200 mm (= 20 cm)&#xD;&#xA;        // - Report arbeitet intern aber mit TenthsOfAMillimeter&#xD;&#xA;        // - Dann bedeutet LocationF = 200 nur 20 mm (= 2 cm)&#xD;&#xA;        //&#xD;&#xA;        // Deshalb wird hier vor dem Setzen von LocationF korrekt umgerechnet.&#xD;&#xA;        if (this.ReportUnit == DevExpress.XtraReports.UI.ReportUnit.TenthsOfAMillimeter)&#xD;&#xA;        {&#xD;&#xA;            // 1 mm = 10 Zehntel-Millimeter&#xD;&#xA;            // Beispiel: 200 mm -&gt; 2000 Report-Einheiten&#xD;&#xA;            x = mmX * 10f;&#xD;&#xA;            y = mmY * 10f;&#xD;&#xA;        }&#xD;&#xA;        else if (this.ReportUnit == DevExpress.XtraReports.UI.ReportUnit.HundredthsOfAnInch)&#xD;&#xA;        {&#xD;&#xA;            // Umrechnung von Millimeter nach Hundertstel Zoll:&#xD;&#xA;            // 1 inch = 25.4 mm&#xD;&#xA;            // 1 inch = 100 HundredthsOfAnInch&#xD;&#xA;            //&#xD;&#xA;            // Formel:&#xD;&#xA;            // mm / 25.4 * 100&#xD;&#xA;            x = mmX / 25.4f * 100f;&#xD;&#xA;            y = mmY / 25.4f * 100f;&#xD;&#xA;        }&#xD;&#xA;        else&#xD;&#xA;        {&#xD;&#xA;            // Fallback:&#xD;&#xA;            // Falls eine andere ReportUnit verwendet wird, werden die Werte unverändert übernommen.&#xD;&#xA;            // Das ist nur ein Sicherheitszweig.&#xD;&#xA;            x = mmX;&#xD;&#xA;            y = mmY;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    catch&#xD;&#xA;    {&#xD;&#xA;        // Fallback bei Fehlern:&#xD;&#xA;        // Wenn ein Parameter fehlt oder unerwartet ist, bleibt die Position bei 0,0.&#xD;&#xA;        // Dadurch wird kein Fehler im Rendering provoziert.&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // Hier wird das Bild tatsächlich neu positioniert.&#xD;&#xA;    // x und y liegen zu diesem Zeitpunkt bereits in der internen Report-Einheit vor.&#xD;&#xA;    box.LocationF = new System.Drawing.PointF(x, y);&#xD;&#xA;&#xD;&#xA;    // Das Bild verwendet AutoSize.&#xD;&#xA;    // Dadurch richtet sich die dargestellte Größe nach dem Bildinhalt.&#xD;&#xA;    // Diese Zeile ändert nicht die Position, sondern nur die Darstellungsart.&#xD;&#xA;    box.Sizing = DevExpress.XtraPrinting.ImageSizeMode.AutoSize;&#xD;&#xA;&#xD;&#xA;    // Sichtbarkeit des Logos:&#xD;&#xA;    // Das Bild wird nur angezeigt, wenn überhaupt ein Logo-Wert vorhanden ist.&#xD;&#xA;    object logoParam = GetParamSafe(&quot;Settings_Logo1&quot;);&#xD;&#xA;    box.Visible = IsValidBase64(logoParam);&#xD;&#xA;        &#xD;&#xA;    // Dynamische Anpassung der Bandhöhe, damit das Bild unten nicht abgeschnitten wird.&#xD;&#xA;    if (box.Band != null &amp;&amp; box.Image != null)&#xD;&#xA;    {&#xD;&#xA;        // Berechnung der Bildhöhe in Hundredths of an Inch.&#xD;&#xA;        // Das Bild liefert Pixelhöhe und DPI-Auflösung.&#xD;&#xA;        // Formel:&#xD;&#xA;        // Pixel / DPI = Höhe in Inch&#xD;&#xA;        // * 100 = Hundredths of an Inch&#xD;&#xA;        float imgHeight = box.Image.Height / box.Image.VerticalResolution * 100f;&#xD;&#xA;&#xD;&#xA;        // Unterkante des Bildes:&#xD;&#xA;        // Position Y + Bildhöhe + kleiner Abstand/Puffer.&#xD;&#xA;        float imageBottom = y + imgHeight + 20f;&#xD;&#xA;&#xD;&#xA;        // Bandhöhe begrenzen:&#xD;&#xA;        // mindestens 250, höchstens 500.&#xD;&#xA;        float finalHeight = Math.Min(Math.Max(250f, imageBottom), 500f);&#xD;&#xA;        box.Band.HeightF = finalHeight;&#xD;&#xA;    }&#xD;&#xA;    else if (box.Band != null)&#xD;&#xA;    {&#xD;&#xA;        // Standardhöhe, falls kein Bild vorhanden ist.&#xD;&#xA;        box.Band.HeightF = 250f;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void xrPictureBox_CustomLogo2_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e)&#xD;&#xA;{&#xD;&#xA;    XRPictureBox box = (XRPictureBox)sender;&#xD;&#xA;&#xD;&#xA;    float x = 0f;&#xD;&#xA;    float y = 0f;&#xD;&#xA;&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        string sx = Convert.ToString(Parameters[&quot;Settings_Logo2PosX&quot;].Value);&#xD;&#xA;        string sy = Convert.ToString(Parameters[&quot;Settings_Logo2PosY&quot;].Value);&#xD;&#xA;&#xD;&#xA;        float mmX = 0f;&#xD;&#xA;        float mmY = 0f;&#xD;&#xA;&#xD;&#xA;        if (sx != null) sx = sx.Replace(',', '.');&#xD;&#xA;        if (sy != null) sy = sy.Replace(',', '.');&#xD;&#xA;&#xD;&#xA;        float.TryParse(&#xD;&#xA;            sx,&#xD;&#xA;            System.Globalization.NumberStyles.Float,&#xD;&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;            out mmX&#xD;&#xA;        );&#xD;&#xA;&#xD;&#xA;        float.TryParse(&#xD;&#xA;            sy,&#xD;&#xA;            System.Globalization.NumberStyles.Float,&#xD;&#xA;            System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;            out mmY&#xD;&#xA;        );&#xD;&#xA;&#xD;&#xA;        if (this.ReportUnit == DevExpress.XtraReports.UI.ReportUnit.TenthsOfAMillimeter)&#xD;&#xA;        {&#xD;&#xA;            x = mmX * 10f;&#xD;&#xA;            y = mmY * 10f;&#xD;&#xA;        }&#xD;&#xA;        else if (this.ReportUnit == DevExpress.XtraReports.UI.ReportUnit.HundredthsOfAnInch)&#xD;&#xA;        {&#xD;&#xA;            x = mmX / 25.4f * 100f;&#xD;&#xA;            y = mmY / 25.4f * 100f;&#xD;&#xA;        }&#xD;&#xA;        else&#xD;&#xA;        {&#xD;&#xA;            x = mmX;&#xD;&#xA;            y = mmY;&#xD;&#xA;        }&#xD;&#xA;    }&#xD;&#xA;    catch&#xD;&#xA;    {&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    box.LocationF = new System.Drawing.PointF(x, y);&#xD;&#xA;    box.Sizing = DevExpress.XtraPrinting.ImageSizeMode.AutoSize;&#xD;&#xA;&#xD;&#xA;    object logoParam = GetParamSafe(&quot;Settings_Logo2&quot;);&#xD;&#xA;    box.Visible = IsValidBase64(logoParam);&#xD;&#xA;&#xD;&#xA;    if (box.Band != null &amp;&amp; box.Image != null)&#xD;&#xA;    {&#xD;&#xA;        float imgHeight = box.Image.Height / box.Image.VerticalResolution * 100f;&#xD;&#xA;        float imageBottom = y + imgHeight + 20f;&#xD;&#xA;        float finalHeight = Math.Min(Math.Max(250f, imageBottom), 500f);&#xD;&#xA;        box.Band.HeightF = finalHeight;&#xD;&#xA;    }&#xD;&#xA;    else if (box.Band != null)&#xD;&#xA;    {&#xD;&#xA;        box.Band.HeightF = 250f;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// Footer Content1 can über die X-Y Koordinaten beliebig in der Fußzeile platziert werden&#xD;&#xA;private void xrRichText_Content1_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e) {&#xD;&#xA;    // XRRichText rt = (XRRichText)sender;&#xD;&#xA;    // float posX = Convert.ToSingle(Parameters[&quot;Settings_Content1PosX&quot;].Value);&#xD;&#xA;    // float posY = Convert.ToSingle(Parameters[&quot;Settings_Content1PosY&quot;].Value);&#xD;&#xA;    // rt.LocationF = new DevExpress.Utils.PointFloat(posX, posY);            &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void lb_SeiteERP_PrintOnPage(object sender, DevExpress.XtraReports.UI.PrintOnPageEventArgs e) {&#xD;&#xA;    XRLabel lbl = (XRLabel)sender;&#xD;&#xA;&#xD;&#xA;    int sprachCode = ToIntSafe(GetCurrentColumnValue(&quot;_SprachCodeERP&quot;), 0);&#xD;&#xA;&#xD;&#xA;    string prefix;&#xD;&#xA;    switch (sprachCode)&#xD;&#xA;    {&#xD;&#xA;        case 1:&#xD;&#xA;            prefix = &quot;Page&quot;;&#xD;&#xA;            break;&#xD;&#xA;        case 2:&#xD;&#xA;            prefix = &quot;Page&quot;;&#xD;&#xA;            break;&#xD;&#xA;        case 3:&#xD;&#xA;            prefix = &quot;Pagina&quot;;&#xD;&#xA;            break;&#xD;&#xA;        default:&#xD;&#xA;            prefix = &quot;Seite&quot;;&#xD;&#xA;            break;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    lbl.Text = string.Format(&quot;{0} {1}/{2}&quot;, prefix, e.PageIndex + 1, e.PageCount);    &#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void xrPictureBox_TestBase64_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e)&#xD;&#xA;{&#xD;&#xA;    XRPictureBox box = sender as XRPictureBox;&#xD;&#xA;    if (box == null) return;&#xD;&#xA;&#xD;&#xA;    object logoParam = GetParamSafe(&quot;Settings_Logo1&quot;);&#xD;&#xA;&#xD;&#xA;    // Test-Ausgabe&#xD;&#xA;    string base64 = ToStringSafe(logoParam).Trim();&#xD;&#xA;&#xD;&#xA;    lblLogoDebug.Text = string.Format(&#xD;&#xA;        &quot;LogoParam null={0}, Länge={1}, Anfang={2}, Base64Valid={3}&quot;,&#xD;&#xA;        logoParam == null,&#xD;&#xA;        base64.Length,&#xD;&#xA;        base64.Length &gt; 30 ? base64.Substring(0, 30) : base64,&#xD;&#xA;        IsValidBase64(logoParam)&#xD;&#xA;    );&#xD;&#xA;&#xD;&#xA;    // Wichtig:&#xD;&#xA;    // Bild wird NICHT per Script geladen.&#xD;&#xA;    // Das macht DevExpress über Image Source = ?Settings_Logo1.&#xD;&#xA;    box.Visible = IsValidBase64(logoParam);&#xD;&#xA;&#xD;&#xA;    box.Sizing = DevExpress.XtraPrinting.ImageSizeMode.ZoomImage;&#xD;&#xA;}" SnapGridSize="10" SnapGridStepCount="5" SnappingMode="SnapToGridAndSnapLines" ReportUnit="TenthsOfAMillimeter" PrinterName="Microsoft Print to PDF" PageWidthF="2100" PageHeightF="2970" Version="25.1" FilterString="[ERP_Code] = ?BzObjMemberCode And [ERP_BZObjType] = ?BzObj