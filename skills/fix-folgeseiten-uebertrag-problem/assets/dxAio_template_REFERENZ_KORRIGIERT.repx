              <ReportSource Ref="1174" ControlType="DXWebAIO.SubReportPartialInvoice, DXWebAIO, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" Dpi="254" ScriptsSource="// ******************************************************************************************************************&#xD;&#xA;// Variablen&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;&#xD;&#xA;// Summen der summenrelevanten Teilrechnungszeilen&#xD;&#xA;decimal nettoSumTR = 0m;&#xD;&#xA;decimal mwstSumTR = 0m;&#xD;&#xA;decimal bruttoSumTR = 0m;&#xD;&#xA;&#xD;&#xA;// Berechnete Restforderung im Footer&#xD;&#xA;decimal nettoZahlbetrag = 0m;&#xD;&#xA;decimal bruttoZahlbetrag = 0m;&#xD;&#xA;decimal mwstZahlbetrag = 0m;&#xD;&#xA;&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;// Hilfsmethoden&#xD;&#xA;// ******************************************************************************************************************private decimal GetDecimalField(string fieldName)&#xD;&#xA;private decimal GetDecimalField(string fieldName)&#xD;&#xA;{&#xD;&#xA;    object value = GetCurrentColumnValue(fieldName);&#xD;&#xA;&#xD;&#xA;    if (value == null || value == DBNull.Value)&#xD;&#xA;        return 0m;&#xD;&#xA;&#xD;&#xA;    if (value is decimal)&#xD;&#xA;        return (decimal)value;&#xD;&#xA;&#xD;&#xA;    string text = Convert.ToString(value);&#xD;&#xA;    if (text != null)&#xD;&#xA;        text = text.Trim();&#xD;&#xA;&#xD;&#xA;    if (string.IsNullOrWhiteSpace(text))&#xD;&#xA;        return 0m;&#xD;&#xA;&#xD;&#xA;    decimal result;&#xD;&#xA;&#xD;&#xA;    if (decimal.TryParse(&#xD;&#xA;        text,&#xD;&#xA;        System.Globalization.NumberStyles.Any,&#xD;&#xA;        System.Globalization.CultureInfo.CurrentCulture,&#xD;&#xA;        out result))&#xD;&#xA;    {&#xD;&#xA;        return result;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    if (decimal.TryParse(&#xD;&#xA;        text,&#xD;&#xA;        System.Globalization.NumberStyles.Any,&#xD;&#xA;        System.Globalization.CultureInfo.InvariantCulture,&#xD;&#xA;        out result))&#xD;&#xA;    {&#xD;&#xA;        return result;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    return 0m;&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private int GetIntField(string fieldName)&#xD;&#xA;{&#xD;&#xA;    object value = GetCurrentColumnValue(fieldName);&#xD;&#xA;    if (value == null || value == DBNull.Value)&#xD;&#xA;        return 0;&#xD;&#xA;&#xD;&#xA;    return Convert.ToInt32(value);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private object GetParamSafe(string name)&#xD;&#xA;{&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        if (Parameters[name] == null)&#xD;&#xA;            return null;&#xD;&#xA;&#xD;&#xA;        if (Parameters[name].Value == null || Parameters[name].Value == DBNull.Value)&#xD;&#xA;            return null;&#xD;&#xA;&#xD;&#xA;        return Parameters[name].Value;&#xD;&#xA;    }&#xD;&#xA;    catch&#xD;&#xA;    {&#xD;&#xA;        return null;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private decimal GetDecimalParameter(string parameterName)&#xD;&#xA;{&#xD;&#xA;    object value = GetParamSafe(parameterName);&#xD;&#xA;&#xD;&#xA;    if (value == null || value == DBNull.Value)&#xD;&#xA;        return 0m;&#xD;&#xA;&#xD;&#xA;    return Convert.ToDecimal(value);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private decimal Round2(decimal value)&#xD;&#xA;{&#xD;&#xA;    return Math.Round(value, 2, MidpointRounding.AwayFromZero);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;// GroupHeader&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;private void GroupHeader1_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e)&#xD;&#xA;{&#xD;&#xA;    // Aktuell keine zusätzliche Logik erforderlich&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;// Detail - nur summenrelevante Zeilen in die Gesamtsumme übernehmen&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;private void Detail_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e)&#xD;&#xA;{&#xD;&#xA;    // 1 = Zeile zählt für Summen, 0 = nur Anzeige&#xD;&#xA;    int countForTotal = GetIntField(&quot;CountForTotal&quot;);&#xD;&#xA;&#xD;&#xA;    if (countForTotal != 1)&#xD;&#xA;        return;&#xD;&#xA;&#xD;&#xA;    decimal netto = GetDecimalField(&quot;TotalNetto&quot;);&#xD;&#xA;    decimal mwstBetrag = GetDecimalField(&quot;TotalMwstBetrag&quot;);&#xD;&#xA;    decimal brutto = GetDecimalField(&quot;TotalBrutto&quot;);&#xD;&#xA;&#xD;&#xA;    nettoSumTR += Round2(netto);&#xD;&#xA;    mwstSumTR += Round2(mwstBetrag);&#xD;&#xA;    bruttoSumTR += Round2(brutto);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;// ReportFooter - Summen ausgeben und Restforderung berechnen&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;private void ReportFooter_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e)&#xD;&#xA;{&#xD;&#xA;    // Summen der Teilrechnungen im Footer anzeigen&#xD;&#xA;    tc_NettoGesamt.Text = nettoSumTR.ToString(&quot;N2&quot;);&#xD;&#xA;    tc_MwStGesamt.Text = mwstSumTR.ToString(&quot;N2&quot;);&#xD;&#xA;    tc_BruttoGesamt.Text = bruttoSumTR.ToString(&quot;N2&quot;);&#xD;&#xA;&#xD;&#xA;    // Summen aus dem Hauptbericht lesen&#xD;&#xA;    decimal totalNetMaster = GetDecimalParameter(&quot;TotalNetValueMasterReport&quot;);&#xD;&#xA;    decimal totalBruttoMaster = GetDecimalParameter(&quot;TotalValueMasterReport&quot;);&#xD;&#xA;&#xD;&#xA;    // Restforderung aus Hauptbericht + Teilrechnungssummen berechnen&#xD;&#xA;    nettoZahlbetrag = Round2(totalNetMaster + nettoSumTR);&#xD;&#xA;    bruttoZahlbetrag = Round2(totalBruttoMaster + bruttoSumTR);&#xD;&#xA;    mwstZahlbetrag = Round2(bruttoZahlbetrag - nettoZahlbetrag);&#xD;&#xA;&#xD;&#xA;    // Restforderung im Footer ausgeben&#xD;&#xA;    tc_RestforderungNetto.Text = nettoZahlbetrag.ToString(&quot;N2&quot;);&#xD;&#xA;    tc_RestforderungMwSt.Text = mwstZahlbetrag.ToString(&quot;N2&quot;);&#xD;&#xA;    tc_RestforderungBrutto.Text = bruttoZahlbetrag.ToString(&quot;N2&quot;);&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;// Reportstart - Laufzeitvariablen vor jedem Durchlauf zurücksetzen&#xD;&#xA;// ******************************************************************************************************************&#xD;&#xA;private void SubReportPartialInvoice_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e)&#xD;&#xA;{&#xD;&#xA;    nettoSumTR = 0m;&#xD;&#xA;    mwstSumTR = 0m;&#xD;&#xA;    bruttoSumTR = 0m;&#xD;&#xA;&#xD;&#xA;    nettoZahlbetrag = 0m;&#xD;&#xA;    bruttoZahlbetrag = 0m;&#xD;&#xA;    mwstZahlbetrag = 0m;&#xD;&#xA;}&#xD;&#xA;" SnapGridSize="25" SnappingMode="SnapToGridAndSnapLines" ReportUnit="TenthsOfAMillimeter" PageWidthF="2100" PageHeightF="2970" Version="25.1" DataMember="Positionen" DataSource="#Ref-1173">
