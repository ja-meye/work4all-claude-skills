            <Item5 Ref="604" ControlType="XRLabel" Name="lblAbsenderAdresse" Dpi="254" Multiline="true" AutoWidth="true" TextAlignment="TopLeft" ForeColor="Black" Padding="10,0,0,0,254">
              <ExpressionBindings>
                <Item1 Ref="605" EventName="BeforePrint" PropertyName="Text" Expression="/*Entweder aus der Druckvorschau den manuell eingegebenen Wert aus AdressLineOverride ausgeben oder die Firmenstammdaten aus dem Mandant ausgeben.*/&#xA;&#xA;Iif(&#xA;    !IsNullOrEmpty(?Settings_AddressLineOverride),&#xA;    ?Settings_AddressLineOverride,&#xA;    Iif(&#xA;        IsNullOrEmpty(?CurrentTenant_Name) AND IsNullOrEmpty(?CurrentTenant_Straße) AND IsNullOrEmpty(?CurrentTenant_PLZ) AND IsNullOrEmpty(?CurrentTenant_Ort),&#xA;        '[_IhreFirmenadresse]',&#xA;        ?CurrentTenant_Name + ' | ' + ?CurrentTenant_Straße + ' | ' + ?CurrentTenant_PLZ + ' ' + ?CurrentTenant_Ort&#xA;    )&#xA;)&#xA;" />
                <Item2 Ref="606" EventName="BeforePrint" PropertyName="ForeColor" Expression="Iif(&#xA;    IsNullOrEmpty(?Settings_AddressLineOverride) AND&#xA;    IsNullOrEmpty(?CurrentTenant_Name) AND&#xA;    IsNullOrEmpty(?CurrentTenant_Straße) AND&#xA;    IsNullOrEmpty(?CurrentTenant_PLZ) AND&#xA;    IsNullOrEmpty(?CurrentTenant_Ort),&#xA;    'SteelBlue',&#xA;    'Black'&#xA;)&#xA;" />
                <Item3 Ref="607" EventName="BeforePrint" PropertyName="StyleName" Expression="'TxtStyle5'" />
              </ExpressionBindings>
              <StylePriority Ref="608" UseForeColor="false" UsePadding="false" UseTextAlignment="false" />
            </Item5>
