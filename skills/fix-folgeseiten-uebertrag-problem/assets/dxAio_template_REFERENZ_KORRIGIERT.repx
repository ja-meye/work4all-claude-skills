                  </ExpressionBindings>
                </Item2>
                <Item3 Ref="635" ControlType="XRTableRow" Name="xrTableRow51" Dpi="254">
                  <Cells>
                    <Item1 Ref="636" ControlType="XRTableCell" Name="xrTableCell106" Dpi="254" Multiline="true" BackColor="Transparent" Padding="5,0,7,0,254">
                      <ExpressionBindings>
                        <Item1 Ref="637" EventName="BeforePrint" PropertyName="StyleName" Expression="Iif([_SettingsLayout] == 'Layout 1', 'TxtStyle1', /* Kontakt-Info: horizontal | mit Tbl-Border-Bottom */&#xA;Iif([_SettingsLayout] == 'Layout 2', 'TxtStyle1', /* Kontakt-Info: horizontal | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 3', 'TxtStyle1', /* Kontakt-Info: oben rechts | mit Tbl-Border-Bottom  */ &#xA;Iif([_SettingsLayout] == 'Layout 4', 'TblStyle3', /* Kontakt-Info: oben rechts | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 5', 'TxtStyle2', /* Kontakt-Info: horizontal | neutral */&#xA;Iif([_SettingsLayout] == 'Layout 6', 'TxtStyle1', /* Kontakt-Info: oben rechts | neutral */&#xA;'TxtStyle1'))))))&#xA;" />
                        <Item2 Ref="638" EventName="BeforePrint" PropertyName="Visible" Expression="[ERP_BZObjType] == '7' And &#xA;(&#xA;&#x9;!IsNullOrEmpty([Leistungsbeginn]) Or &#xA;&#x9;!IsNullOrEmpty([Leistungsende])&#xA;) And&#xA;(&#xA;&#x9;IsNull([ERP_WartungsobjektCode]) Or&#xA;&#x9;[ERP_WartungsobjektCode] == 0&#xA;)&#xA;" />
                      </ExpressionBindings>
                      <StylePriority Ref="639" UsePadding="false" />
                    </Item1>
                    <Item2 Ref="640" ControlType="XRTableCell" Name="xrTableCell107" Dpi="254" Multiline="true" Padding="10,0,7,0,254">
                      <ExpressionBindings>
                        <Item1 Ref="641" EventName="BeforePrint" PropertyName="StyleName" Expression="Iif([_SettingsLayout] == 'Layout 1', 'TxtStyle1', /* Kontakt-Info: horizontal | mit Tbl-Border-Bottom */&#xA;Iif([_SettingsLayout] == 'Layout 2', 'TxtStyle1', /* Kontakt-Info: horizontal | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 3', 'TxtStyle1', /* Kontakt-Info: oben rechts | mit Tbl-Border-Bottom  */ &#xA;Iif([_SettingsLayout] == 'Layout 4', 'TblStyle3', /* Kontakt-Info: oben rechts | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 5', 'TxtStyle2', /* Kontakt-Info: horizontal | neutral */&#xA;Iif([_SettingsLayout] == 'Layout 6', 'TxtStyle1', /* Kontakt-Info: oben rechts | neutral */&#xA;'TxtStyle1'))))))&#xA;" />
                        <Item2 Ref="642" EventName="BeforePrint" PropertyName="Text" Expression="Iif(&#xA;    IsNullOrEmpty([Leistungsbeginn]),&#xA;        Iif(&#xA;            IsNullOrEmpty([Leistungsende]),&#xA;            '',&#xA;            FormatString('{0:dd.MM.yyyy}', [Leistungsende])&#xA;        ),&#xA;        Iif(&#xA;            IsNullOrEmpty([Leistungsende]),&#xA;            FormatString('{0:dd.MM.yyyy}', [Leistungsbeginn]),&#xA;            Iif(&#xA;                [Leistungsbeginn] == [Leistungsende],&#xA;                FormatString('{0:dd.MM.yyyy}', [Leistungsbeginn]),&#xA;                FormatString('{0:dd.MM.yyyy}', [Leistungsbeginn]) + ' - ' + FormatString('{0:dd.MM.yyyy}', [Leistungsende])&#xA;            )&#xA;        )&#xA;)&#xA;" />
