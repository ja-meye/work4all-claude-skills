                <Item2 Ref="611" EventName="BeforePrint" PropertyName="Text" Expression="Iif([ERP_BZObjType] == '4', [ERP_Hauptadresse], &#xA;    [ERP_BZObjType] == '5', [ERP_Hauptadresse],&#xA;    [ERP_BZObjType] == '6', [ERP_Hauptadresse],&#xA;    [ERP_BZObjType] == '7', [ERP_NebenAdrText2],&#xA;    [ERP_BZObjType] == '8' &amp;&amp; [ERP_SDObjType] == 0, [ERP_Hauptadresse],&#xA;    [ERP_BZObjType] == '8', [ERP_NebenAdrText1],&#xA;    [ERP_BZObjType] == '9', [ERP_Hauptadresse],&#xA;    [ERP_BZObjType] == '10', [ERP_Hauptadresse], '')&#xA;&#xA;/* &#xA;BzObjType 4 = Kalkulation &#xA;BzObjType 8 = Rücklieferschein (SDObjType = 0)&#xA;BzObjType 10 = Bedarfsanforderung&#xA;*/" />
              </ExpressionBindings>
