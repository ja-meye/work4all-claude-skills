    <Item23 Ref="102" Name="_ApTelERP" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Telefon:',&#xA;    [_SprachCodeERP]==1,'Telephone:',&#xA;    [_SprachCodeERP]==2,'Téléphone:',&#xA;    [_SprachCodeERP]==3,'Telefoon:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item24 Ref="103" Name="_ApEmailERP" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'E-Mail:',&#xA;    [_SprachCodeERP]==1,'E-Mail:',&#xA;    [_SprachCodeERP]==2,'E-Mail:',&#xA;    [_SprachCodeERP]==3,'E-Mail:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item25 Ref="104" Name="_ProjektERP" Expression="Iif(&#xA;    [_SprachCodeERP] == 0,'Projekt:',&#xA;    [_SprachCodeERP] == 1,'Project:',&#xA;    [_SprachCodeERP] == 2,'Projet:',&#xA;    [_SprachCodeERP] == 3,'Project:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item26 Ref="105" Name="_StattGPreisPOS" FieldType="String" Expression="/*'(' + FormatString('{0:n2}', [calcStattGPreis]) + ')' + NewLine() + [POS_Frei3]*/" DataMember="w4a_ERPObject" />
    <Item27 Ref="106" Name="_ZahlungszielERP_AN_AB" FieldType="String" Expression="Iif([ERP_ZahlungsfristTg] == 0,&#xA;    Iif(&#xA;        [_SprachCodeERP] == 1,&#xA;        'Invoices are due immediately after receipt of invoice without deduction.',&#xA;        [_SprachCodeERP] == 2,&#xA;        'Payable: immédiatement sans retenue.',&#xA;        [_SprachCodeERP] == 3,&#xA;        'Facturen dienen contant en direct na ontvangst van de factuur te worden betaald.',&#xA;        'Zahlbar sofort nach Rechnungsstellung ohne Abzug.'&#xA;    ),&#xA;    Iif(&#xA;        [_SprachCodeERP] == 1,&#xA;        'Payment due within ' + FormatString('{0:0}', [ERP_ZahlungsfristTg]) + ' days of the invoice date without deduction.',&#xA;        [_SprachCodeERP] == 2,&#xA;        'Payable: en l''espace de ' + FormatString('{0:0}', [ERP_ZahlungsfristTg]) + ' jours sans retenue.',&#xA;        [_SprachCodeERP] == 3,&#xA;        'Betaling binnen ' + FormatString('{0:0}', [ERP_ZahlungsfristTg]) + ' dagen na factuurdatum.',&#xA;        'Zahlbar innerhalb von ' + FormatString('{0:0}', [ERP_ZahlungsfristTg]) + ' Tagen nach Rechnungsstellung ohne Abzug.'&#xA;    )&#xA;)" DataMember="w4a_ERPObject" />
    <Item28 Ref="107" Name="_ZahlungszielERP_RE" FieldType="String" Expression="Iif(&#xA;  [ERP_ZahlungsfristTg] == 0,&#xA;&#xA;  /*Case: Immediate payment*/&#xA;  Iif(&#xA;    [_SprachCodeERP] == 1,&#xA;    'Invoices are due and payable upon receipt without deduction.',&#xA;    [_SprachCodeERP] == 2,&#xA;    'Payable: immédiatement sans retenue.',&#xA;    [_SprachCodeERP] == 3,&#xA;    'Facturen dienen direct na ontvangst contant en netto te worden betaald&quot;.',&#xA;    'Zahlbar sofort ohne Abzug.'&#xA;  ),&#xA;  Iif(&#xA;    [_SprachCodeERP] == 1,&#xA;    'Payable until ' + FormatString('{0:dd.MM.yyyy}', [ERP_ZahlungsfristDat]) + ' without deduction.',&#xA;    [_SprachCodeERP] == 2,&#xA;    'Dû avant le ' + FormatString('{0:dd.MM.yyyy}', [ERP_ZahlungsfristDat]) + ' sans retenue.',&#xA;    [_SprachCodeERP] == 3,&#xA;    'Betaling uiterlijk tot ' + FormatString('{0:dd.MM.yyyy}', [ERP_ZahlungsfristDat]) + ' zonder korting.',&#xA;    'Zahlbar bis zum ' + FormatString('{0:dd.MM.yyyy}', [ERP_ZahlungsfristDat]) + ' ohne Abzug.'&#xA;  )&#xA;)" DataMember="w4a_ERPObject" />
    <Item29 Ref="108" Name="_ZahlungszielERP_BE" FieldType="String" Expression="Iif(&#xA;  [ERP_ZahlungsfristTg] == 0,&#xA;&#xA;  /*Case: Immediate payment*/&#xA;  Iif(&#xA;    [_SprachCodeERP] == 1,&#xA;    'Payment after receipt of invoice.',&#xA;    [_SprachCodeERP] == 2,&#xA;    'Payable: immédiatement sans retenue.',&#xA;    [_SprachCodeERP] == 3,&#xA;    'Betaling netto contant na ontvangst factuur.',&#xA;    'Zahlung nach Rechnungseingang.'&#xA;  ),&#xA;&#xA;  /*Case: Payment after X days*/&#xA;  Iif(&#xA;    [_SprachCodeERP] == 1,&#xA;    'Payment within ' + FormatString('{0:0}', [ERP_ZahlungsfristTg]) + ' days after invoice.',&#xA;    [_SprachCodeERP] == 2,&#xA;    'Payable: en l''espace de ' + FormatString('{0:0}', [ERP_ZahlungsfristTg]) + ' jours sans retenue.',&#xA;    [_SprachCodeERP] == 3,&#xA;    'Betaling binnen ' + FormatString('{0:0}', [ERP_ZahlungsfristTg]) + ' dagen na factuurdatum.',&#xA;    'Zahlung innerhalb von ' + FormatString('{0:0}', [ERP_ZahlungsfristTg]) + ' Tagen nach Rechnungseingang.'&#xA;  )&#xA;)" DataMember="w4a_ERPObject" />
    <Item30 Ref="109" Name="_ZahlungsbedingungenERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Zahlungsziel:',  /*Standard: Zahlungsbedingungen:*/&#xA;    [_SprachCodeERP]==1,'Terms of Payment:',&#xA;    [_SprachCodeERP]==2,'Conditions de paiement:',&#xA;    [_SprachCodeERP]==3,'Betalingscondities:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item31 Ref="110" Name="_SkontoERP_AN_AB" FieldType="String" Expression="Iif(&#xA;  [ERP_SkontoProzent] != 0,&#xA;  Iif(&#xA;    Round([ERP_SkontoProzent], 0) == [ERP_SkontoProzent],&#xA;    'Abzüglich ' + FormatString('{0:0}', [ERP_SkontoProzent]) + ' % Skonto innerhalb von ' + FormatString('{0:0}', [ERP_SkontoFristTg]) + ' Tagen auf die skontoberechtigten Artikel.',&#xA;    'Abzüglich ' + FormatString('{0:0.00}', [ERP_SkontoProzent]) + ' % Skonto innerhalb von ' + FormatString('{0:0.00}', [ERP_SkontoFristTg]) + ' Tagen auf die skontoberechtigten Artikel.'&#xA;  ),&#xA;  ''&#xA;)" DataMember="w4a_ERPObject" />
    <Item32 Ref="111" Name="_SkontoERP_RE" FieldType="String" Expression="Iif(&#xA;  [ERP_SkontoProzent] != 0,&#xA;  Iif(&#xA;    Round([ERP_SkontoProzent], 0) == [ERP_SkontoProzent],&#xA;    'Abzüglich ' + FormatString('{0:0}', [ERP_SkontoProzent]) + ' % Skonto bis zum ' + FormatString('{0:dd.MM.yyyy}', [ERP_SkontoFristDat]) + ' auf die skontoberechtigten Artikel.',&#xA;    'Abzüglich ' + FormatString('{0:0.00}', [ERP_SkontoProzent]) + ' % Skonto bis zum ' + FormatString('{0:dd.MM.yyyy}', [ERP_SkontoFristDat]) + ' auf die skontoberechtigten Artikel.'&#xA;  ),&#xA;  ''&#xA;)" DataMember="w4a_ERPObject" />
    <Item33 Ref="112" Name="_SkontoERP_BE" FieldType="String" Expression="Iif(&#xA;  [ERP_SkontoProzent] != 0,&#xA;  Iif(&#xA;    Round([ERP_SkontoProzent], 0) == [ERP_SkontoProzent],&#xA;    'Abzüglich ' + FormatString('{0:0}', [ERP_SkontoProzent]) + ' % Skonto innerhalb von ' + FormatString('{0:0}', [ERP_SkontoFristTg]) + ' Tagen.',&#xA;    'Abzüglich ' + FormatString('{0:0.00}', [ERP_SkontoProzent]) + ' % Skonto innerhalb von ' + FormatString('{0:0}', [ERP_SkontoFristTg]) + ' Tagen.'&#xA;  ),&#xA;  ''&#xA;)" DataMember="w4a_ERPObject" />
    <Item34 Ref="113" Name="_RE_HinweisReNrERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Bitte bei Zahlung die vollständige Rechnungsnummer angeben!',&#xA;    [_SprachCodeERP]==1,'When paying, please indicate our invoice number!',&#xA;    [_SprachCodeERP]==2,'Lors du paiement, veuillez indiquer notre numéro de facture!',&#xA;    [_SprachCodeERP]==3,'Vermeld bij de betaling het volledige factuurnummer!',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item35 Ref="114" Name="_RE_HinweisERechnungERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Elektronische Rechnung an ' + [ADR2_RgEMailAdresse],&#xA;    [_SprachCodeERP]==1,'E-mail invoice to ' + [ADR2_RgEMailAdresse],&#xA;    [_SprachCodeERP]==2,'E-mail facture à ' + [ADR2_RgEMailAdresse],&#xA;    [_SprachCodeERP]==3,'Elektronische factuur naar ' + [ADR2_RgEMailAdresse],&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item36 Ref="115" Name="_Hinweis10ProzPOS" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS]==0,'-10 % bei jährl. Zahlung',&#xA;    [_SprachCodePOS]==1,'-10 % for annual payment',&#xA;    [_SprachCodePOS]==2,'–10 % annuel',&#xA;    [_SprachCodePOS]==3,'-10% bij jaarlijkse betaling',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item37 Ref="116" Name="_HinweisZuschlagPOS" FieldType="String" Expression="'x ' + ToStr([POS_Zuschlag]) + ' ' + [_MonatePOS] + ''" DataMember="w4a_ERPObject" />
    <Item38 Ref="117" Name="_MonatePOS" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS]==0,'Monate',&#xA;    [_SprachCodePOS]==1,'months',&#xA;    [_SprachCodePOS]==2,'mois',&#xA;    [_SprachCodePOS]==3,'maanden',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item39 Ref="118" Name="_bestehendAusSLPOS" FieldType="String" Expression="Iif([_SprachCodeSLPOS]==0,'bestehend aus:',&#xA;Iif([_SprachCodeSLPOS]==1,'consisting of',&#xA;Iif([_SprachCodeSLPOS]==2,'consisting of','x')))&#xA;" DataMember="w4a_ERPObject.w4a_ERPObjectSLKomponenten" />
    <Item40 Ref="119" Name="_SprachCodeSLPOS" FieldType="String" Expression="Iif(?Context_BzObjectLanguageCode==0,0,&#xA;&#x9;Iif(?Context_BzObjectLanguageCode==13,1,&#xA;&#x9;&#x9;Iif(?Context_BzObjectLanguageCode==14,2,0)&#xA;&#x9;)&#xA;)&#xA;" DataMember="w4a_ERPObject.w4a_ERPObjectSLKomponenten" />
    <Item41 Ref="120" Name="_InfoTextSLPOS" FieldType="String" Expression="Iif([_SprachCodeSLPOS]==0,'Einige Module sind derzeit nur in der Desktop-Version von work4all verfügbar.',&#xA;Iif([_SprachCodeSLPOS]==1,'Some modules are currently only available in the desktop version of work4all.',&#xA;Iif([_SprachCodeSLPOS]==2,'Some modules are currently only available in the desktop version of work4all.','x')))&#xA;" DataMember="w4a_ERPObject.w4a_ERPObjectSLKomponenten" />
    <Item42 Ref="121" Name="_BestellnummerIhreERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Ihre Bestell-Nr.:',&#xA;    [_SprachCodeERP]==1,'Your Order No.:',&#xA;    [_SprachCodeERP]==2,'Votre N° de cde.:',&#xA;    [_SprachCodeERP]==3,'Uw bestelnummer:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item43 Ref="122" Name="_UStIDIhreERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Kd. USt-IdNr.:',&#xA;    [_SprachCodeERP]==1,'Cust. VAT No.:',&#xA;    [_SprachCodeERP]==2,'N° de TVA client:',&#xA;    [_SprachCodeERP]==3,'BTW-nummer klant:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item44 Ref="123" Name="_Währung" FieldType="String" Expression="Iif([WAEHRUNG_Waehrung] == 'EUR', '€', [WAEHRUNG_Waehrung])" DataMember="w4a_ERPObject" />
    <Item45 Ref="124" Name="_WährungÜbertrag" FieldType="String" Expression="Iif(&#xA;    ?ArgShowTitleOverview,&#xA;    Iif([WAEHRUNG_Waehrung] = 'EUR', '€', [WAEHRUNG_Waehrung]),&#xA;    Iif([WAEHRUNG_Waehrung] = 'EUR', '€' + Char(10) + '   ', [WAEHRUNG_Waehrung] + Char(10) + '   '))&#xA;&#xA;/*Der Platzhalter ist wichtig für die Druckoption &quot;Titelsummen andrucken&quot; auf Seite 1, somit wird der Abstand auf Seite 2 reguliert*/" DataMember="w4a_ERPObject" />
    <Item46 Ref="125" Name="_GültigkeitAN" Expression="Iif(&#xA;    [ERP_Datum] == [ERP_Gueltigkeit], '',&#xA;    [_SprachCodeERP] == 1,&#xA;        'This offer is valid until: ' + FormatString('{0:dd.MM.yyyy}', [ERP_Gueltigkeit]),&#xA;    [_SprachCodeERP] == 2,&#xA;        'Cette offre reste valable jusqu''au: ' + FormatString('{0:dd.MM.yyyy}', [ERP_Gueltigkeit]),&#xA;    [_SprachCodeERP] == 0,&#xA;        'Dieses Angebot ist gültig bis zum: ' + FormatString('{0:dd.MM.yyyy}', [ERP_Gueltigkeit]),&#xA;    [_SprachCodeERP] == 3,&#xA;        'Deze offerte is geldig tot: ' + FormatString('{0:dd.MM.yyyy}', [ERP_Gueltigkeit]),&#xA;    ''&#xA;)" DataMember="w4a_ERPObject" />
    <Item47 Ref="126" Name="_KontoinhaberERP" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Kontoinhaber:',&#xA;    [_SprachCodeERP]==1,'Account holder:',&#xA;    [_SprachCodeERP]==2,'Titulaire du compte:',&#xA;    [_SprachCodeERP]==3,'Rekeninghouder:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item48 Ref="127" Name="_BankNameERP" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Bank:',&#xA;    [_SprachCodeERP]==1,'Bank:',&#xA;    [_SprachCodeERP]==2,'Banque:',&#xA;    [_SprachCodeERP]==3,'Bank:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item49 Ref="128" Name="_UStIdERP" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'USt-IdNr.:',&#xA;    [_SprachCodeERP]==1,'VAT ID:',&#xA;    [_SprachCodeERP]==2,'Numéro de TVA:',&#xA;    [_SprachCodeERP]==3,'BTW-nummer:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item50 Ref="129" Name="_GfERP" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Geschäftsführer:',&#xA;    [_SprachCodeERP]==1,'Managing Director:',&#xA;    [_SprachCodeERP]==2,'Directeur général:',&#xA;    [_SprachCodeERP]==3,'Directeur:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item51 Ref="130" Name="_StattGPreisERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'* (Sofern Positions-Gesamtpreise in Klammern ausgewiesen sind, sind diese im Gesamtbetrag nicht enthalten.)',&#xA;    [_SprachCodeERP]==1,'* (Position totals in brackets are not part of the total amount.)',&#xA;    [_SprachCodeERP]==2,'* (Les totaux de position entre parenthèses ne sont pas inclus dans le montant total.)',&#xA;    [_SprachCodeERP]==3,'* (Indien de totale prijzen per artikel tussen haakjes worden vermeld, zijn deze niet in het totaalbedrag inbegrepen.)',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item52 Ref="131" Name="_LTgleichREdatum" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Sofern nicht anders angegeben, entspricht das Lieferdatum dem Rechnungsdatum.',&#xA;    [_SprachCodeERP]==1,'Unless otherwise stated, the delivery date corresponds to the invoice date.',&#xA;    [_SprachCodeERP]==2,'Sauf indication contraire, la date de livraison correspond à la date de facture.',&#xA;    [_SprachCodeERP]==3,'Tenzij anders vermeld, is de leveringsdatum gelijk aan de factuurdatum.',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item53 Ref="132" Name="_LieferdatumERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Lieferdatum:',&#xA;    [_SprachCodeERP]==1,'Delivery date:',&#xA;    [_SprachCodeERP]==2,'Date de livraison:',&#xA;    [_SprachCodeERP]==3,'Leverdatum:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item54 Ref="133" Name="_LeistungszeitraumERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Leistungszeitraum:',&#xA;    [_SprachCodeERP]==1,'Service period:',&#xA;    [_SprachCodeERP]==2,'Période de prestation:',&#xA;    [_SprachCodeERP]==3,'Serviceperiode:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item55 Ref="134" Name="_LeistungszeitraumDatumERP" Expression="Iif(IsNullOrEmpty([Leistungsbeginn]),&#xA;    Iif(IsNullOrEmpty([Leistungsende]), '', FormatString('{0:dd.MM.yyyy}', [Leistungsende])),&#xA;    Iif(IsNullOrEmpty([Leistungsende]),&#xA;        FormatString('{0:dd.MM.yyyy}', [Leistungsbeginn]),&#xA;        FormatString('{0:dd.MM.yyyy}', [Leistungsbeginn]) + ' - ' + FormatString('{0:dd.MM.yyyy}', [Leistungsende])&#xA;    )&#xA;)&#xA;" DataMember="w4a_ERPObject" />
    <Item56 Ref="135" Name="_Skontohinweis" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Mit (*) gekennzeichnete Positionen sind von der Skontoberechnung ausgeschlossen.',&#xA;    [_SprachCodeERP]==1,'Items marked with (*) are excluded from the discount calculation.',&#xA;    [_SprachCodeERP]==2,'Les articles marqués d’un (*) sont exclus du calcul de la remise.',&#xA;    [_SprachCodeERP]==3,'Posities gemarkeerd met (*) worden niet meegenomen in de berekening van de korting.',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item57 Ref="136" Name="_Rabatt" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS] == 0,'Rabatt ' + [POS_Rabatt] + ' % = ' + [WAEHRUNG_Waehrung] + ' ' + FormatString('{0:N2}',Abs([calcRabattProPos])),&#xA;    [_SprachCodePOS] == 1,'Discount ' + [POS_Rabatt] + ' % = ' + [WAEHRUNG_Waehrung] + ' ' + FormatString('{0:N2}',Abs([calcRabattProPos])),&#xA;    [_SprachCodePOS] == 2,'Remise ' + [POS_Rabatt] + ' % = ' + [WAEHRUNG_Waehrung] + ' ' + FormatString('{0:N2}',Abs([calcRabattProPos])),&#xA;    [_SprachCodePOS] == 3,'Korting ' + [POS_Rabatt] + ' % = ' + [WAEHRUNG_Waehrung] + ' ' + FormatString('{0:N2}',Abs([calcRabattProPos])),&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item58 Ref="137" Name="_Staffelung" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Staffel:',&#xA;    [_SprachCodeERP]==1,'Scale:',&#xA;    [_SprachCodeERP]==2,'Échelle:',&#xA;    [_SprachCodeERP]==3,'Staffel:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item59 Ref="138" Name="_HinweisNettopreisZzglMwstERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Alle Preise verstehen sich als Nettopreise zuzüglich der gesetzlich vorgeschriebenen Mehrwertsteuer.',&#xA;    [_SprachCodeERP]==1,'All prices are net prices plus the statutory value added tax.',&#xA;    [_SprachCodeERP]==2,'Tous les prix s entendent nets, hors TVA légale.',&#xA;    [_SprachCodeERP]==3,'Alle prijzen zijn netto prijzen exclusief de wettelijk verschuldigde btw.',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item60 Ref="139" Name="_Dimensionen" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Aktuell: 50,8 mm x 11,9 mm mit 300 dpi Auflösung',&#xA;    [_SprachCodeERP]==1,'Current: 50,8 mm x 11,9 mm with 300 dpi resolution',&#xA;    [_SprachCodeERP]==2,'Actuel : 50,8 mm × 11,9 mm avec une résolution de 300 dpi',&#xA;    [_SprachCodeERP]==3,'Actueel: 50,8 mm x 11,9 mm met 300 dpi resolutie',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item61 Ref="140" Name="_IhrLogo" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'IHR FIRMENLOGO',&#xA;    [_SprachCodeERP]==1,'YOUR COMPANY LOGO',&#xA;    [_SprachCodeERP]==2,'VOTRE LOGO D’ENTREPRISE',&#xA;    [_SprachCodeERP]==3,'UW BEDRIJFSLOGO',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item62 Ref="141" Name="_IhreFirmenadresse" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Ihr Firmenname und Adresse',&#xA;    [_SprachCodeERP]==1,'Your company name and address',&#xA;    [_SprachCodeERP]==2,'Votre nom et adresse d entreprise',&#xA;    [_SprachCodeERP]==3,'Uw bedrijfsnaam en adres',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item63 Ref="142" Name="_Rabatt2" FieldType="String" Expression="Iif(&#xA;    Not IsNull([POS_Rabatt2]) And [POS_Rabatt2] &gt; 0,&#xA;&#xA;    Iif([_SprachCodeERP] == 1, 'Discount2 ',&#xA;        Iif([_SprachCodeERP] == 2, 'Remise2 ', 'Rabatt2 '))&#xA;    + FormatString('{0:0.##}', [POS_Rabatt2]) + ' % = '&#xA;    + [WAEHRUNG_Waehrung] + ' '&#xA;    + FormatString('{0:0.00}',&#xA;        Abs(&#xA;            [POS_Anzahl] * [POS_EinzPreis] * [POS_Zuschlag] *&#xA;            (1 - ([POS_Rabatt] * 0.01)) *&#xA;            ([POS_Rabatt2] * 0.01)&#xA;        )&#xA;    ),&#xA;&#xA;    ''&#xA;)&#xA;" DataMember="w4a_ERPObject" />
    <Item64 Ref="143" Name="_MwStERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'MwSt.',&#xA;    [_SprachCodeERP]==1,'VAT',&#xA;    [_SprachCodeERP]==2,'TVA',&#xA;    [_SprachCodeERP]==3,'BTW',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item65 Ref="144" Name="_GesamtNettoERP" DisplayName="_GesamtNettoERP" Expression="Iif(&#xA;    [_SprachCodePOS]==0,'Gesamt netto',&#xA;    [_SprachCodePOS]==1,'Total net',&#xA;    [_SprachCodePOS]==2,'Montant net',&#xA;    [_SprachCodePOS]==3,'Totaal netto',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item66 Ref="145" Name="_MwSt19ERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS] == 0, 'Mehrwertsteuer 19% auf ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT19Total]),&#xA;    [_SprachCodePOS] == 1, 'VAT 19% on ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT19Total]),&#xA;    [_SprachCodePOS] == 2, 'TVA 19% sur ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT19Total]),&#xA;    [_SprachCodePOS] == 3, 'BTW 19% op ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT19Total]),&#xA;    'x'&#xA;)&#xA;&#xA;/* MwSt. Berechnung für Test-Zwecke */" DataMember="w4a_ERPObject" />
    <Item67 Ref="146" Name="_MwSt0ERP" DisplayName="_MwSt0ERP" Expression="Iif(&#xA;    [_SprachCodePOS]==0,('Mehrwertsteuer 0% auf ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT0Total])),&#xA;    [_SprachCodePOS]==1,('VAT 0% on ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT0Total])),&#xA;    [_SprachCodePOS]==2,('TVA 0% sur ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT0Total])),&#xA;    [_SprachCodePOS]==3,('BTW 0% op ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT0Total])),&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item68 Ref="147" Name="_MwSt7ERP" DisplayName="_MwSt7ERP" Expression="Iif(&#xA;    [_SprachCodePOS]==0,('Mehrwertsteuer 7% auf ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT7Total])),&#xA;    [_SprachCodePOS]==1,('VAT 7% on ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT7Total])),&#xA;    [_SprachCodePOS]==2,('TVA 7% sur ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT7Total])),&#xA;    [_SprachCodePOS]==3,('BTW 7% op ' + [_Währung] + ' ' + FormatString('{0:#,0.00}', [calcSumVAT7Total])),&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item69 Ref="148" Name="_GesamtBruttoERP" DisplayName="_GesamtBruttoERP" Expression="Iif(&#xA;    [_SprachCodePOS] == 0, 'Gesamtbetrag',&#xA;    [_SprachCodePOS] == 1, 'Total amount',&#xA;    [_SprachCodePOS] == 2, 'Montant total',&#xA;    [_SprachCodePOS] == 3, 'Totaal',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item70 Ref="149" Name="bool_ERPKorrektur" FieldType="Boolean" Expression="[ERP_Rechnungsart_BT3] == '381' Or [ERP_Rechnungsart_BT3] == '384'" DataMember="w4a_ERPObject" />
    <Item71 Ref="150" Name="bool_ShowHinweis10Proz" FieldType="Boolean" DataMember="w4a_ERPObject" />
    <Item72 Ref="151" Name="bool_ShowHinweisRabatt" FieldType="Boolean" Expression="[ERP_BZObjType] &lt;&gt; '8'&#xA;And [POS_ArtikelArt] In (0, -8, -10, -24)&#xA;And Not IsNull([POS_Rabatt]) &#xA;And [POS_Rabatt] &lt;&gt; 0" DataMember="w4a_ERPObject" />
    <Item73 Ref="152" Name="calcSumGesPreis" FieldType="Decimal" DisplayName="calcSumGesPreis" Expression="Iif(&#xA;    sum([POS_GesPreis]) &gt;= 0,&#xA;    Floor(sum([POS_GesPreis]) * 100 + 0.5) / 100,&#xA;    Ceiling(sum([POS_GesPreis]) * 100 - 0.5) / 100&#xA;)&#xA;/* Kaufmännisches Runden (AwayFromZero) statt Banker’s Rounding */" DataMember="w4a_ERPObject" />
    <Item74 Ref="153" Name="calcSumBrutto" FieldType="Decimal" DisplayName="calcSumBrutto" Expression="Round(&#xA;    IsNull([calcSumGesPreis], 0)&#xA;    + IsNull([calcSumVAT1], 0)&#xA;    + IsNull([calcSumVAT2], 0)&#xA;    + IsNull([calcSumVAT3], 0)&#xA;    + IsNull([calcSumVAT4], 0)&#xA;    + IsNull([calcSumVAT5], 0)&#xA;    + IsNull([calcSumVAT6], 0),&#xA;    5&#xA;)&#xA;&#xA;/* &#xA;Bei Teil-/Schlussrechnung wird die MwSt aus den Positionsdaten ermittelt,&#xA;andernfalls wird der Parameter MwSt-Gruppe-Gesamtwert ausgegeben. &#xA;*/&#xA;&#xA;" DataMember="w4a_ERPObject" />
    <Item75 Ref="154" Name="calcSumBruttoParam" FieldType="Decimal" Expression="/* Round([calcSumGesPreis]&#xA;  + ?Context_BzObjectVatGroup1Total&#xA;  + ?Context_BzObjectVatGroup2Total&#xA;  + ?Context_BzObjectVatGroup3Total&#xA;  + ?Context_BzObjectVatGroup4Total&#xA;  + ?Context_BzObjectVatGroup5Total&#xA;  + ?Context_BzObjectVatGroup6Total,&#xA;  2&#xA;)&#xA;Achtung: diese Formel mit calSumBrutto ersetzen sobald Parameter-Übergabe funktioniert &#xA;&#xA;Iif(IsNull([calcSumVAT19Total]) OR [calcSumVAT19Total] == 0,&#xA;    Round([calcSumGesPreis],2),&#xA;    Round([calcSumGesPreis] + [calcSumVAT19] + Iif(IsNull([calcSumVAT7]) OR [calcSumVAT7] == 0, 0, [calcSumVAT7]),2)&#xA;)&#xA;*/" DataMember="w4a_ERPObject" />
    <Item76 Ref="155" Name="calcSumSkonto" FieldType="Double" Expression="sum(Iif(Not [ARTIKEL_NichtSkontofähig], [POS_GesPreis], 0)) * [ERP_SkontoProzent] / 100" DataMember="w4a_ERPObject" />
    <Item77 Ref="156" Name="calcSumGesamtBrutto" FieldType="Decimal" Expression="/* Achtung diese Formel verwendet im Script-Teil ein GetValue-Event und wird für die Skontoberechnung verwendet: calcSumGesamtBrutto_GetValue */" DataMember="w4a_ERPObject">
      <Scripts Ref="157" OnGetValue="calcSumGesamtBrutto_GetValue" />
    </Item77>
    <Item78 Ref="158" Name="calcSumSkontoPosBetrag" Expression="/* Achtung diese Formel verwendet im Script-Teil ein GetValue-Event und wird für die Skontoberechnung verwendet: calcSumGesamtBrutto_GetValue | calcSumSkontoPosBetrag_GetValue */" DataMember="w4a_ERPObject">
      <Scripts Ref="159" OnGetValue="calcSumSkontoPosBetrag_GetValue" />
    </Item78>
    <Item79 Ref="160" Name="calcSumStattGPreis" FieldType="Int16" Expression="/* Achtung diese Formel verwendet im Script-Teil ein GetValue-Event und wird für die Sichtbarkeit für StattGPreis Hinweis im Footer verwendet: calcSumStattGPreis_GetValue */&#xA;" DataMember="w4a_ERPObject" />
    <Item80 Ref="161" Name="calcRabattProPos" FieldType="Decimal" DisplayName="calcRabattProPos" Expression="([POS_Anzahl]*[POS_EinzPreis])*[POS_Zuschlag]*([POS_Rabatt]/100)" DataMember="w4a_ERPObject" />
    <Item81 Ref="162" Name="calcGPreisOhneRabattProPos" FieldType="Decimal" Expression="([POS_Anzahl]*[POS_EinzPreis]*[POS_Zuschlag])-[calcRabattProPos]&#xA;" DataMember="w4a_ERPObject" />
    <Item82 Ref="163" Name="calcStattGPreis" FieldType="String" Expression="Round(&#xA;    Iif(IsNull([POS_Rabatt]) OR [POS_Rabatt] == 0, &#xA;        [POS_EinzPreis] * [POS_Anzahl] * [POS_Zuschlag], &#xA;        [POS_EinzPreis] * [POS_Anzahl] * [POS_Zuschlag] * (1 - [POS_Rabatt] / 100)&#xA;    ),&#xA;2)" DataMember="w4a_ERPObject" />
    <Item83 Ref="164" Name="calcSumVAT0Total" FieldType="Decimal" DisplayName="calcSumVAT0Total" Expression="[][0=[POS_Mwst]].Sum([POS_GesPreis])&#xA;" DataMember="w4a_ERPObject" />
    <Item84 Ref="165" Name="calcSumVAT19" FieldType="Decimal" DisplayName="calcSumVAT19" Expression="/*Because you’re hitting floating-point precision in the expression.&#xA;Your calc is effectively:&#xA;[POS_GesPreis] * ([POS_Mwst] / 100)&#xA;When 19/100 is evaluated as a floating (double) you often get 0.189999999….&#xA;So 142.50 * 0.1899999… = 27.07499966…, which then formats to 27,07 instead of 27,08.&#xA;Fix: force decimal math, then round&#xA;Use ToDecimal so the division is exact and then round to 2 decimals*/&#xA;&#xA;/* MwSt. Berechnung für Test-Zwecke */&#xA;&#xA;Round([][[POS_Mwst] == 19].Sum([POS_GesPreis] * (ToDecimal([POS_Mwst]) / ToDecimal(100))), 2)" DataMember="w4a_ERPObject" />
    <Item85 Ref="166" Name="calcSumVAT19Total" FieldType="Decimal" DisplayName="calcSumVAT19Total" Expression="[][[POS_Mwst] == 19].Sum([POS_GesPreis])&#xA;&#xA;/* MwSt. Berechnung für Test-Zwecke */" DataMember="w4a_ERPObject" />
    <Item86 Ref="167" Name="calcSumVAT7" FieldType="Decimal" Expression="Round([][[POS_Mwst] == 7].Sum([POS_GesPreis] * ([POS_Mwst]/100)),2)&#xA;&#xA;" DataMember="w4a_ERPObject" />
    <Item87 Ref="168" Name="calcSumVAT7Total" FieldType="Decimal" Expression="[][[POS_Mwst]==7].Sum([POS_GesPreis])&#xA;" DataMember="w4a_ERPObject" />
    <Item88 Ref="169" Name="calcSumVAT1" FieldType="Decimal" Expression="Iif([HatTeilrechnung] &gt; 0,&#xA;&#x9;Round([][[POS_Mwst] == ?Context_BzObjectVatGroup1Rate].Sum([POS_GesPreis] * &#x9;(ToDecimal([POS_Mwst]) / ToDecimal(100))), 5),&#xA;&#x9;?Context_BzObjectVatGroup1Total&#xA;)&#xA;&#xA;/* &#xA;Bei Teil-/Schlussrechnung wird die MwSt aus den Positionsdaten ermittelt,&#xA;andernfalls wird der Parameter MwSt-Gruppe-Gesamtwert ausgegeben. &#xA;*/&#xA;" DataMember="w4a_ERPObject" />
    <Item89 Ref="170" Name="calcSumVAT2" FieldType="Decimal" Expression="Iif([HatTeilrechnung] &gt; 0,&#xA;&#x9;Round([][[POS_Mwst] == ?Context_BzObjectVatGroup2Rate].Sum([POS_GesPreis] * &#x9;(ToDecimal([POS_Mwst]) / ToDecimal(100))), 5),&#xA;&#x9;?Context_BzObjectVatGroup2Total&#xA;)&#xA;&#xA;/*Round([][[POS_Mwst] == ?Context_BzObjectVatGroup2Rate].Sum([POS_GesPreis] * (ToDecimal([POS_Mwst]) / ToDecimal(100))), 2)*/&#xA;" DataMember="w4a_ERPObject" />
    <Item90 Ref="171" Name="calcSumVAT3" FieldType="Decimal" Expression="Iif([HatTeilrechnung] &gt; 0,&#xA;&#x9;Round([][[POS_Mwst] == ?Context_BzObjectVatGroup3Rate].Sum([POS_GesPreis] * &#x9;(ToDecimal([POS_Mwst]) / ToDecimal(100))), 5),&#xA;&#x9;?Context_BzObjectVatGroup3Total&#xA;)&#xA;&#xA;/*Round([][[POS_Mwst] == ?Context_BzObjectVatGroup3Rate].Sum([POS_GesPreis] * (ToDecimal([POS_Mwst]) / ToDecimal(100))), 2)*/&#xA;" DataMember="w4a_ERPObject" />
    <Item91 Ref="172" Name="calcSumVAT4" FieldType="Decimal" Expression="Iif([HatTeilrechnung] &gt; 0,&#xA;&#x9;Round([][[POS_Mwst] == ?Context_BzObjectVatGroup4Rate].Sum([POS_GesPreis] * &#x9;(ToDecimal([POS_Mwst]) / ToDecimal(100))), 5),&#xA;&#x9;?Context_BzObjectVatGroup4Total&#xA;)&#xA;&#xA;/*Round([][[POS_Mwst] == ?Context_BzObjectVatGroup4Rate].Sum([POS_GesPreis] * (ToDecimal([POS_Mwst]) / ToDecimal(100))), 2)*/&#xA;&#xA;" DataMember="w4a_ERPObject" />
    <Item92 Ref="173" Name="calcSumVAT5" FieldType="Decimal" Expression="Iif([HatTeilrechnung] &gt; 0,&#xA;&#x9;Round([][[POS_Mwst] == ?Context_BzObjectVatGroup5Rate].Sum([POS_GesPreis] * &#x9;(ToDecimal([POS_Mwst]) / ToDecimal(100))), 5),&#xA;&#x9;?Context_BzObjectVatGroup5Total&#xA;)&#xA;&#xA;/*Round([][[POS_Mwst] == ?Context_BzObjectVatGroup5Rate].Sum([POS_GesPreis] * (ToDecimal([POS_Mwst]) / ToDecimal(100))), 2)*/&#xA;&#xA;" DataMember="w4a_ERPObject" />
    <Item93 Ref="174" Name="calcSumVAT6" FieldType="Decimal" Expression="Iif([HatTeilrechnung] &gt; 0,&#xA;&#x9;Round([][[POS_Mwst] == ?Context_BzObjectVatGroup6Rate].Sum([POS_GesPreis] * &#x9;(ToDecimal([POS_Mwst]) / ToDecimal(100))), 5),&#xA;&#x9;?Context_BzObjectVatGroup6Total&#xA;)&#xA;&#xA;/*Round([][[POS_Mwst] == ?Context_BzObjectVatGroup6Rate].Sum([POS_GesPreis] * (ToDecimal([POS_Mwst]) / ToDecimal(100))), 2)*/&#xA;&#xA;" DataMember="w4a_ERPObject" />
    <Item94 Ref="175" Name="_MwSt1ERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS] == 0, 'Mehrwertsteuer ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup1Rate) + '% auf ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT1Total]),&#xA;    [_SprachCodePOS] == 1, 'VAT ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup1Rate) + '% on ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT1Total]),&#xA;    [_SprachCodePOS] == 2, 'TVA ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup1Rate) + '% sur ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT1Total]),&#xA;    [_SprachCodePOS] == 3, 'BTW ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup1Rate) + '% op ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT1Total]),&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item95 Ref="176" Name="_MwSt2ERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS] == 0, 'Mehrwertsteuer ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup2Rate) + '% auf ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT2Total]),&#xA;    [_SprachCodePOS] == 1, 'VAT ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup2Rate) + '% on ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT2Total]),&#xA;    [_SprachCodePOS] == 2, 'TVA ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup2Rate) + '% sur ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT2Total]),&#xA;    [_SprachCodePOS] == 3, 'BTW ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup2Rate) + '% op ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT2Total]),&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item96 Ref="177" Name="_MwSt3ERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS] == 0, 'Mehrwertsteuer ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup3Rate) + '% auf ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT3Total]),&#xA;    [_SprachCodePOS] == 1, 'VAT ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup3Rate) + '% on ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT3Total]),&#xA;    [_SprachCodePOS] == 2, 'TVA ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup3Rate) + '% sur ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT3Total]),&#xA;    [_SprachCodePOS] == 3, 'BTW ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup3Rate) + '% op ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT3Total]),&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item97 Ref="178" Name="_MwSt4ERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS] == 0, 'Mehrwertsteuer ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup4Rate) + '% auf ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT4Total]),&#xA;    [_SprachCodePOS] == 1, 'VAT ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup4Rate) + '% on ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT4Total]),&#xA;    [_SprachCodePOS] == 2, 'TVA ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup4Rate) + '% sur ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT4Total]),&#xA;    [_SprachCodePOS] == 3, 'BTW ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup4Rate) + '% op ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT4Total]),&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item98 Ref="179" Name="_MwSt5ERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS] == 0, 'Mehrwertsteuer ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup5Rate) + '% auf ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT5Total]),&#xA;    [_SprachCodePOS] == 1, 'VAT ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup5Rate) + '% on ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT5Total]),&#xA;    [_SprachCodePOS] == 2, 'TVA ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup5Rate) + '% sur ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT5Total]),&#xA;    [_SprachCodePOS] == 3, 'BTW ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup5Rate) + '% op ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT5Total]),&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item99 Ref="180" Name="_MwSt6ERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS] == 0, 'Mehrwertsteuer ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup6Rate) + '% auf ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT6Total]),&#xA;    [_SprachCodePOS] == 1, 'VAT ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup6Rate) + '% on ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT6Total]),&#xA;    [_SprachCodePOS] == 2, 'TVA ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup6Rate) + '% sur ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT6Total]),&#xA;    [_SprachCodePOS] == 3, 'BTW ' + FormatString('{0:0.##}', ?Context_BzObjectVatGroup6Rate) + '% op ' + [_Währung] + ' ' + FormatString('{0:N2}', [calcSumVAT6Total]),&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item100 Ref="181" Name="calcSumVAT1Total" FieldType="Decimal" Expression="[][[POS_Mwst]==?Context_BzObjectVatGroup1Rate].Sum(Round([POS_GesPreis], 2))" DataMember="w4a_ERPObject" />
    <Item101 Ref="182" Name="calcSumVAT2Total" FieldType="Decimal" Expression="[][[POS_Mwst]==?Context_BzObjectVatGroup2Rate].Sum(Round([POS_GesPreis], 2))" DataMember="w4a_ERPObject" />
    <Item102 Ref="183" Name="calcSumVAT3Total" FieldType="Decimal" Expression="[][[POS_Mwst]==?Context_BzObjectVatGroup3Rate].Sum(Round([POS_GesPreis], 2))" DataMember="w4a_ERPObject" />
    <Item103 Ref="184" Name="calcSumVAT4Total" FieldType="Decimal" Expression="[][[POS_Mwst]==?Context_BzObjectVatGroup4Rate].Sum(Round([POS_GesPreis], 2))" DataMember="w4a_ERPObject" />
    <Item104 Ref="185" Name="calcSumVAT5Total" FieldType="Decimal" Expression="[][[POS_Mwst]==?Context_BzObjectVatGroup5Rate].Sum(Round([POS_GesPreis], 2))" DataMember="w4a_ERPObject" />
    <Item105 Ref="186" Name="calcSumVAT6Total" FieldType="Decimal" Expression="[][[POS_Mwst]==?Context_BzObjectVatGroup6Rate].Sum(Round([POS_GesPreis], 2))" DataMember="w4a_ERPObject" />
    <Item106 Ref="187" Name="_SettingsLayout" FieldType="String" Expression="/* Layout Combo or Boolean */&#xA;Iif(&#xA;    IsNullOrEmpty(?ArgLayoutCB),&#xA;    Iif(?ArgLayout, 'Layout 4', 'Layout 1'),&#xA;    ?ArgLayoutCB&#xA;)" DataMember="w4a_ERPObject" />
    <Item107 Ref="188" Name="_SettingsLayout1" FieldType="String" Expression="/* Layout Combo or Boolean */&#xA;Iif(&#xA;    IsNullOrEmpty(?ArgLayoutCB),&#xA;    Iif(?ArgLayout, 'Layout 4', 'Layout 1'),&#xA;    ?ArgLayoutCB&#xA;)&#xA;" DataMember="w4a_ERPObject.w4a_ERPObjectSLKomponenten" />
    <Item108 Ref="189" Name="_SettingsLayout2" FieldType="String" Expression="/* Layout Combo or Boolean */&#xA;Iif(&#xA;    IsNullOrEmpty(?ArgLayoutCB),&#xA;    Iif(?ArgLayout, 'Layout 4', 'Layout 1'),&#xA;    ?ArgLayoutCB&#xA;)&#xA;" DataMember="w4a_ERPObject.w4a_ERPObjectPOS_Staffelpreise" />
    <Item109 Ref="190" Name="_VersandartLieferzeitERP" FieldType="String" Expression="Iif([LIart_Lieferungsziel] &gt; 0,&#xA;    Iif([_SprachCodeERP] == 1,' (' + ToStr([LIart_Lieferungsziel]) + ' days)',&#xA;        [_SprachCodeERP] == 2,' (' + ToStr([LIart_Lieferungsziel]) + ' jours)',&#xA;&#x9; [_SprachCodeERP] == 3,' (' + ToStr([LIart_Lieferungsziel]) + ' dagen)',&#xA;        ' (' + ToStr([LIart_Lieferungsziel]) + ' Tg.)'&#xA;    ),&#xA;    ''&#xA;)" DataMember="w4a_ERPObject" />
    <Item110 Ref="191" Name="_ArtikelNrPOS" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS]==0,'Art.-Nr.: ',&#xA;    [_SprachCodePOS]==1,'Art.-no.: ',&#xA;    [_SprachCodePOS]==2,'N° d article: ',&#xA;    [_SprachCodePOS]==3,'Art.-nr.: ',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item111 Ref="192" Name="_LieferterminPOS" Expression="Iif(&#xA;    [_SprachCodePOS]==0,'Lieferdatum: ',&#xA;    [_SprachCodePOS]==1,'Delivery date: ',&#xA;    [_SprachCodePOS]==2,'Date de livraison: ',&#xA;    [_SprachCodePOS]==3,'Leverdatum: ',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item112 Ref="193" Name="_LTDatumPOS" FieldType="String" Expression="Iif(&#xA;&#x9;[POS_ArtikelArt] In (0,-10)&#xA;&#x9;And IsNull([ERP_Liefertermin])&#xA;&#x9;And Not(IsNull([POS_Liefertermin])),&#xA;&#x9;[_LieferterminPOS] + FormatString('{0:dd.MM.yyyy}', [POS_Liefertermin]),&#xA;&#x9;''&#xA;)&#xA;" DataMember="w4a_ERPObject" />
    <Item113 Ref="194" Name="_BezeichnungAndArtNrPOS" Expression="/* ArtikelNr + Bezeichnung, optional mit interner Bemerkung */&#xA;Iif(&#xA;    ?ArgShowArticleNo&#xA;    And [POS_ArtikelArt] In (0, -8, -10, -24)&#xA;    And Not IsNull([POS_ArtNr])&#xA;    And [POS_ArtNr] != '',&#xA;    [_ArtikelNrPOS] + [POS_ArtNr] + NewLine(),&#xA;    ''&#xA;)&#xA;+ [POS_Bezeichnung]&#xA;+&#xA;/* Interner Text */&#xA;Iif(&#xA;    ?ArgShowInternalText&#xA;    And Not IsNull([POS_Bemerkung])&#xA;    And [POS_Bemerkung] != '',&#xA;    NewLine() + [POS_Bemerkung],&#xA;    ''&#xA;)" DataMember="w4a_ERPObject" />
    <Item114 Ref="195" Name="_Freigabeverfahren" FieldType="Boolean" Expression="Iif(?Context_ApprovalChainState In (0,3), False, True)" DataMember="w4a_ERPObject" />
    <Item115 Ref="196" Name="_SettingsHintergrundfarbe" FieldType="String" DisplayName="_SettingsHintergrundfarbe" Expression="'#B6D0EF'" DataMember="w4a_ERPObject" />
    <Item116 Ref="197" Name="_ZollTarifnummerPOS" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS]==0,'Zolltarif-Nr.: ',&#xA;    [_SprachCodePOS]==1,'Taric code no.: ',&#xA;    [_SprachCodePOS]==2,'Numéro de code TARIC : ',&#xA;    [_SprachCodePOS]==3,'Taric code: ',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item117 Ref="198" Name="_HerkunftslandPOS" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS]==0,'Herkunftsland: ',&#xA;    [_SprachCodePOS]==1,'COO: ',&#xA;    [_SprachCodePOS]==2,'PDO: ',&#xA;    [_SprachCodePOS]==3,'Herkomstland: ',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item118 Ref="199" Name="_BezeichnungSLPOS" FieldType="String" Expression="Replace([Bezeichnung], Char(13), '[CR]')" DataMember="w4a_ERPObject.w4a_ERPObjectSLKomponenten" />
    <Item119 Ref="200" Name="_HRB_ERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'HRB:',&#xA;    [_SprachCodeERP]==1,'Commercial Register:',&#xA;    [_SprachCodeERP]==2,'Registre du commerce:',&#xA;    [_SprachCodeERP]==3,'KvK:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item120 Ref="201" Name="_GerichtsstandERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'Gerichtsstand:',&#xA;    [_SprachCodeERP]==1,'Jurisdiction:',&#xA;    [_SprachCodeERP]==2,'Jurisdiction:',&#xA;    [_SprachCodeERP]==3,'Bevoegde rechtbank:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item121 Ref="202" Name="_UStIdEigeneERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'UStID:',&#xA;    [_SprachCodeERP]==1,'VAT ID:',&#xA;    [_SprachCodeERP]==2,'Numéro de TVA:',&#xA;    [_SprachCodeERP]==3,'BTW-nummer:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item122 Ref="203" Name="_GF_ERP" FieldType="String" Expression="Iif(&#xA;    [_SprachCodeERP]==0,'GF:',&#xA;    [_SprachCodeERP]==1,'CEO:',&#xA;    [_SprachCodeERP]==2,'CEO:',&#xA;    [_SprachCodeERP]==3,'CEO:',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item123 Ref="204" Name="_AnfragenummerERP" Expression="Iif([_SprachCodeERP]==0,'Ihre Anfrage:',&#xA;    [_SprachCodeERP]==1,'Your Inquiry:',&#xA;    [_SprachCodeERP]==2,'Votre demande:',&#xA;    [_SprachCodeERP]==3,'Uw aanvraag',&#xA;    ''&#xA;)" DataMember="w4a_ERPObject" />
    <Item124 Ref="205" Name="_GewichtPOS" FieldType="String" Expression="Iif(&#xA;    [_SprachCodePOS]==0,'Gewicht: ',&#xA;    [_SprachCodePOS]==1,'Weight: ',&#xA;    [_SprachCodePOS]==2,'Poids: ',&#xA;    [_SprachCodePOS]==3,'Gewicht: ',&#xA;    'x'&#xA;)" DataMember="w4a_ERPObject" />
    <Item125 Ref="206" Name="calculatedField1" DataMember="w4a_ERPObject" />
  </CalculatedFields>
