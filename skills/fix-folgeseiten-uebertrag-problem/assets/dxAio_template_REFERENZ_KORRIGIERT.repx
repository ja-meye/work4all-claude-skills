              <ReportSource Ref="463" ControlType="DXWebAIO.SubReportPosBilder, DXWebAIO, Version=1.0.0.0, Culture=neutral, PublicKeyToken=null" Dpi="254" ScriptsSource="&#xD;&#xA;// Die Methode prüft vor dem Drucken, ob im Feld DAT_Data tatsächlich ein gültiges Base64-Bild vorhanden ist.&#xD;&#xA;// Wenn nicht, wird die XRPictureBox ausgeblendet.&#xD;&#xA;private bool IsValidBase64Image(object imageData)&#xD;&#xA;{&#xD;&#xA;    if (imageData == null || imageData == DBNull.Value)&#xD;&#xA;        return false;&#xD;&#xA;&#xD;&#xA;    string base64 = Convert.ToString(imageData);&#xD;&#xA;&#xD;&#xA;    if (string.IsNullOrWhiteSpace(base64) ||&#xD;&#xA;        base64 == &quot;0&quot; ||&#xD;&#xA;        base64.Equals(&quot;false&quot;, StringComparison.OrdinalIgnoreCase))&#xD;&#xA;    {&#xD;&#xA;        return false;&#xD;&#xA;    }&#xD;&#xA;&#xD;&#xA;    // Leerzeichen entfernen&#xD;&#xA;    base64 = System.Text.RegularExpressions.Regex.Replace(base64, @&quot;\s+&quot;, &quot;&quot;);&#xD;&#xA;&#xD;&#xA;    // Base64 muss durch 4 teilbar sein&#xD;&#xA;    if (base64.Length % 4 != 0)&#xD;&#xA;        return false;&#xD;&#xA;&#xD;&#xA;    try&#xD;&#xA;    {&#xD;&#xA;        Convert.FromBase64String(base64);&#xD;&#xA;        return true;&#xD;&#xA;    }&#xD;&#xA;    catch&#xD;&#xA;    {&#xD;&#xA;        return false;&#xD;&#xA;    }&#xD;&#xA;}&#xD;&#xA;&#xD;&#xA;private void xrPictureBox1_BeforePrint(object sender, System.ComponentModel.CancelEventArgs e)&#xD;&#xA;{&#xD;&#xA;    XRPictureBox box = sender as XRPictureBox;&#xD;&#xA;&#xD;&#xA;    if (box == null)&#xD;&#xA;        return;&#xD;&#xA;&#xD;&#xA;    object imageData = GetCurrentColumnValue(&quot;DAT_Data&quot;);&#xD;&#xA;&#xD;&#xA;    box.Visible = IsValidBase64Image(imageData);&#xD;&#xA;}&#xD;&#xA;" SnapGridSize="25" SnappingMode="SnapToGridAndSnapLines" ReportUnit="TenthsOfAMillimeter" Margins="0, 0, 0, 12.7" PaperKind="Custom" PageWidthF="970" PageHeightF="2794" Version="25.1" DataMember="w4a_ArtikelDateien" DataSource="#Ref-462" Font="Arial, 9.75pt">
