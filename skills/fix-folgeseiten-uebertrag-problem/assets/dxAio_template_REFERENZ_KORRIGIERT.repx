                  </ExpressionBindings>
                </Item1>
                <Item2 Ref="625" ControlType="XRTableRow" Name="xrTableRow50" Dpi="254">
                  <Cells>
                    <Item1 Ref="626" ControlType="XRTableCell" Name="xrTableCell102" Dpi="254" Multiline="true" BackColor="Transparent" Padding="5,0,7,0,254">
                      <ExpressionBindings>
                        <Item1 Ref="627" EventName="BeforePrint" PropertyName="StyleName" Expression="Iif([_SettingsLayout] == 'Layout 1', 'TxtStyle1', /* Kontakt-Info: horizontal | mit Tbl-Border-Bottom */&#xA;Iif([_SettingsLayout] == 'Layout 2', 'TxtStyle1', /* Kontakt-Info: horizontal | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 3', 'TxtStyle1', /* Kontakt-Info: oben rechts | mit Tbl-Border-Bottom  */ &#xA;Iif([_SettingsLayout] == 'Layout 4', 'TblStyle3', /* Kontakt-Info: oben rechts | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 5', 'TxtStyle2', /* Kontakt-Info: horizontal | neutral */&#xA;Iif([_SettingsLayout] == 'Layout 6', 'TxtStyle1', /* Kontakt-Info: oben rechts | neutral */&#xA;'TxtStyle1'))))))&#xA;" />
                        <Item2 Ref="628" EventName="BeforePrint" PropertyName="Text" Expression="/* Liefertermin */&#xA;Iif(&#xA;    ([ERP_BZObjType] == '5' Or [ERP_BZObjType] == '6' Or [ERP_BZObjType] == '9') And Not IsNull([ERP_Liefertermin]),&#xA;    [_LieferdatumERP],&#xA;    Iif(&#xA;        [ERP_BZObjType] == '7' And Not IsNull([ERP_Liefertermin2]),&#xA;        [_LieferdatumERP],&#xA;        ''&#xA;    )&#xA;)&#xA;" />
                      </ExpressionBindings>
                      <StylePriority Ref="629" UseBackColor="false" UsePadding="false" />
                    </Item1>
                    <Item2 Ref="630" ControlType="XRTableCell" Name="xrTableCell103" Dpi="254" Multiline="true" Padding="10,0,7,0,254">
                      <ExpressionBindings>
                        <Item1 Ref="631" EventName="BeforePrint" PropertyName="StyleName" Expression="Iif([_SettingsLayout] == 'Layout 1', 'TxtStyle1', /* Kontakt-Info: horizontal | mit Tbl-Border-Bottom */&#xA;Iif([_SettingsLayout] == 'Layout 2', 'TxtStyle1', /* Kontakt-Info: horizontal | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 3', 'TxtStyle1', /* Kontakt-Info: oben rechts | mit Tbl-Border-Bottom  */ &#xA;Iif([_SettingsLayout] == 'Layout 4', 'TblStyle3', /* Kontakt-Info: oben rechts | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 5', 'TxtStyle2', /* Kontakt-Info: horizontal | neutral */&#xA;Iif([_SettingsLayout] == 'Layout 6', 'TxtStyle1', /* Kontakt-Info: oben rechts | neutral */&#xA;'TxtStyle1'))))))&#xA;" />
                        <Item2 Ref="632" EventName="BeforePrint" PropertyName="Text" Expression="/* Liefertermin */&#xA;Iif(&#xA;    ([ERP_BZObjType] == '5' Or [ERP_BZObjType] == '6' Or [ERP_BZObjType] == '9') And Not IsNull([ERP_Liefertermin]),&#xA;    FormatString('{0:dd.MM.yyyy}', [ERP_Liefertermin]),&#xA;    Iif(&#xA;        [ERP_BZObjType] == '7' And Not IsNull([ERP_Liefertermin2]),&#xA;        FormatString('{0:dd.MM.yyyy}', [ERP_Liefertermin2]),&#xA;        ''&#xA;    )&#xA;)&#xA;" />
                      </ExpressionBindings>
                      <StylePriority Ref="633" UsePadding="false" />
                    </Item2>
                  </Cells>
                  <ExpressionBindings>
