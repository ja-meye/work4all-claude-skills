            <Item2 Ref="1629" ControlType="XRLabel" Name="lb_SkontoERP_AN_AB" Dpi="254" Multiline="true" ForeColor="Black" Padding="10,0,0,0,254">
              <Summary Ref="1630" Running="Group" />
              <ExpressionBindings>
                <Item1 Ref="1631" EventName="BeforePrint" PropertyName="StyleName" Expression="Iif([_SettingsLayout] == 'Layout 1', 'TxtStyle2', /* Kontakt-Info: horizontal | mit Tbl-Border-Bottom */&#xA;Iif([_SettingsLayout] == 'Layout 2', 'TxtStyle2', /* Kontakt-Info: horizontal | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 3', 'TxtStyle2', /* Kontakt-Info: oben rechts | mit Tbl-Border-Bottom  */ &#xA;Iif([_SettingsLayout] == 'Layout 4', 'TxtStyle2', /* Kontakt-Info: oben rechts L/R | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 5', 'TxtStyle2', /* Kontakt-Info: horizontal | neutral */&#xA;Iif([_SettingsLayout] == 'Layout 6', 'TxtStyle2', /* Kontakt-Info: oben rechts | neutral */&#xA;'TxtStyle2'))))))&#xA;" />
                <Item2 Ref="1632" EventName="BeforePrint" PropertyName="Text" Expression="Iif([ERP_SkontoProzent] != 0,&#xA;    Iif([_SprachCodeERP] == 0, 'Abzüglich ' + FormatString('{0:0.##}', [ERP_SkontoProzent]) +&#xA;&#x9;' % Skonto innerhalb von ' + FormatString('{0:0}', [ERP_SkontoFristTg]) +&#xA;&#x9;' Tagen auf die skontoberechtigten Artikel. Zahlbetrag: ' +&#xA;&#x9;FormatString('{0:N2}', sumSum([calcSumGesamtBrutto]) - sumSum([calcSumSkontoPosBetrag])) + ' ' + [_Währung],&#xA;&#xA;    &#x9;[_SprachCodeERP] == 1, 'Less ' + FormatString('{0:0.##}', [ERP_SkontoProzent]) +&#xA;    &#x9;'% discount within ' + FormatString('{0:0}', [ERP_SkontoFristTg]) +&#xA;    &#x9;' days on eligible items. Total payable: ' +&#xA;    &#x9;FormatString('{0:N2}', sumSum([calcSumGesamtBrutto]) - sumSum([calcSumSkontoPosBetrag])) + ' ' + [_Währung],&#xA;&#xA;    &#x9;[_SprachCodeERP] == 2, 'Moins ' + FormatString('{0:0.##}', [ERP_SkontoProzent]) +&#xA;    &#x9;'% d’escompte en ' + FormatString('{0:0}', [ERP_SkontoFristTg]) +&#xA;    &#x9;' jours sur les articles éligibles. Montant à payer: ' +&#xA;    &#x9;FormatString('{0:N2}', sumSum([calcSumGesamtBrutto]) - sumSum([calcSumSkontoPosBetrag])) + ' ' + [_Währung],&#xA;&#xA;    &#x9;[_SprachCodeERP] == 3, 'Min ' + FormatString('{0:0.##}', [ERP_SkontoProzent]) +&#xA;    &#x9;'% korting op de afgeprijsde artikelen bij betaling binnen ' + FormatString('{0:0}', [ERP_SkontoFristTg]) +&#xA;    &#x9;' dagen. Betaalbedrag ' +&#xA;    &#x9;FormatString('{0:N2}', sumSum([calcSumGesamtBrutto]) - sumSum([calcSumSkontoPosBetrag])) + ' ' + [_Währung],&#xA;  ''&#xA;  )&#xA;,&#xA;'')&#xA;/*da hier Summen gebildet und verrechnet werden, kann diese Logik nicht in einem Calculated-Field oder Script abgebildet werden. Dort steht die sumSum Funktion nicht zur Verfügung*/" />
              </ExpressionBindings>
              <StylePriority Ref="1633" UseForeColor="false" UsePadding="false" />
            </Item2>
          </Controls>
          <ExpressionBindings>
            <Item1 Ref="1634" EventName="BeforePrint" PropertyName="Visible" Expression="Iif(&#xA;&#x9;[ERP_BZObjType] In ('5','6') And &#xA;&#x9;[ERP_ZahlungsCode] == 0 And&#x9;&#x9;&#xA;&#x9;[ERP_SkontoProzent] != 0 And &#xA;&#x9;?ArgShowSum,&#xA;  &#x9;True,&#xA;  &#x9;False&#xA;)" />
          </ExpressionBindings>
        </Item8>
