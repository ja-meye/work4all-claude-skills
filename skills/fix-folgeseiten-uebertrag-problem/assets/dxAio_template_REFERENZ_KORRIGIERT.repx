              <Summary Ref="1650" Running="Group" IgnoreNullValues="true" />
              <ExpressionBindings>
                <Item1 Ref="1651" EventName="BeforePrint" PropertyName="StyleName" Expression="Iif([_SettingsLayout] == 'Layout 1', 'TxtStyle2', /* Kontakt-Info: horizontal | mit Tbl-Border-Bottom */&#xA;Iif([_SettingsLayout] == 'Layout 2', 'TxtStyle2', /* Kontakt-Info: horizontal | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 3', 'TxtStyle2', /* Kontakt-Info: oben rechts | mit Tbl-Border-Bottom  */ &#xA;Iif([_SettingsLayout] == 'Layout 4', 'TxtStyle2', /* Kontakt-Info: oben rechts L/R | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 5', 'TxtStyle2', /* Kontakt-Info: horizontal | neutral */&#xA;Iif([_SettingsLayout] == 'Layout 6', 'TxtStyle2', /* Kontakt-Info: oben rechts | neutral */&#xA;'TxtStyle2'))))))&#xA;" />
                <Item2 Ref="1652" EventName="BeforePrint" PropertyName="Text" Expression="Iif([ERP_SkontoProzent] != 0,&#xA;  Iif([_SprachCodeERP] == 0,&#xA;    Iif(Round([ERP_SkontoProzent], 0) == [ERP_SkontoProzent],&#xA;      'Abzüglich ' + FormatString('{0:0}', [ERP_SkontoProzent]) + ' % Skonto innerhalb von ' + FormatString('{0:0}', [ERP_SkontoFristTg]) + ' Tagen. Zahlbetrag: ' +&#xA;      FormatString('{0:#,0.00}', sumSum([calcSumGesamtBrutto]) - sumSum([calcSumSkontoPosBetrag])) + ' ' + [_Währung],&#xA;      'Abzüglich ' + FormatString('{0:0.00}', [ERP_SkontoProzent]) + ' % Skonto innerhalb von ' + FormatString('{0:0}', [ERP_SkontoFristTg]) + ' Tagen. Zahlbetrag: ' +&#xA;      FormatString('{0:#,0.00}', sumSum([calcSumGesamtBrutto]) - sumSum([calcSumSkontoPosBetrag])) + ' ' + [_Währung]&#xA;    ),&#xA;&#xA;  [_SprachCodeERP] == 1, 'Less ' + FormatString('{0:0.##}', [ERP_SkontoProzent]) + '% discount within ' + FormatString('{0:0}', [ERP_SkontoFristTg]) + ' days. Total payable: ' +&#xA;    FormatString('{0:#,0.00}', sumSum([calcSumGesamtBrutto]) - sumSum([calcSumSkontoPosBetrag])) + ' ' + [_Währung],&#xA;&#xA;  [_SprachCodeERP] == 2, 'Moins ' + FormatString('{0:0.##}', [ERP_SkontoProzent]) + ' % d’escompte en ' + FormatString('{0:0}', [ERP_SkontoFristTg]) + ' jours. Montant à payer: ' +&#xA;    FormatString('{0:#,0.00}', sumSum([calcSumGesamtBrutto]) - sumSum([calcSumSkontoPosBetrag])) + ' ' + [_Währung],&#xA;&#xA;  [_SprachCodeERP] == 3, 'Min ' + FormatString('{0:0.##}', [ERP_SkontoProzent]) + ' % korting bij betaling binnen ' + FormatString('{0:0}', [ERP_SkontoFristTg]) + ' dagen. Betaalbedrag: ' +&#xA;    FormatString('{0:#,0.00}', sumSum([calcSumGesamtBrutto]) - sumSum([calcSumSkontoPosBetrag])) + ' ' + [_Währung],&#xA;  ''&#xA;  )&#xA;,&#xA;''&#xA;)" />
