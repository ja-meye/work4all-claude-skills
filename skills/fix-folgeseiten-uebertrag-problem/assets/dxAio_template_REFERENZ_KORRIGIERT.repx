            <Item2 Ref="1639" ControlType="XRLabel" Name="lb_SkontoERP_RE" Dpi="254" Multiline="true" Padding="10,0,0,0,254">
              <Summary Ref="1640" Running="Group" IgnoreNullValues="true" />
              <ExpressionBindings>
                <Item1 Ref="1641" EventName="BeforePrint" PropertyName="StyleName" Expression="Iif([_SettingsLayout] == 'Layout 1', 'TxtStyle2', /* Kontakt-Info: horizontal | mit Tbl-Border-Bottom */&#xA;Iif([_SettingsLayout] == 'Layout 2', 'TxtStyle2', /* Kontakt-Info: horizontal | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 3', 'TxtStyle2', /* Kontakt-Info: oben rechts | mit Tbl-Border-Bottom  */ &#xA;Iif([_SettingsLayout] == 'Layout 4', 'TxtStyle2', /* Kontakt-Info: oben rechts L/R | Tbl-Border-L/R */&#xA;Iif([_SettingsLayout] == 'Layout 5', 'TxtStyle2', /* Kontakt-Info: horizontal | neutral */&#xA;Iif([_SettingsLayout] == 'Layout 6', 'TxtStyle2', /* Kontakt-Info: oben rechts | neutral */&#xA;'TxtStyle2'))))))&#xA;" />
                <Item2 Ref="1642" EventName="BeforePrint" PropertyName="Text" Expression="Iif([ERP_SkontoProzent] != 0,&#xA;  &#x9;Iif([_SprachCodeERP] == 0,'Abzüglich ' + FormatString('{0:0.##}', [ERP_SkontoProzent]) +&#xA;    &#x9;' % Skonto bis zum ' + FormatString('{0:dd.MM.yyyy}', [ERP_SkontoFristDat]) +&#xA;    &#x9;' auf die skontoberechtigten Artikel.' +&#xA;    &#x9;&#x9;Iif([ERP_Rechnungsart_BT3] == '380' And [ERP_Art] == 0,&#xA;      &#x9;&#x9;' Zahlbetrag: ',&#xA;      &#x9;&#x9;''&#xA;    &#x9;&#x9;),&#xA;    &#xA;&#x9;[_SprachCodeERP] == 1,'Less ' + FormatString('{0:0.##}', [ERP_SkontoProzent]) +&#xA;      ' % discount until ' + FormatString('{0:dd.MM.yyyy}', [ERP_SkontoFristDat]) +&#xA;      ' on eligible items.' +&#xA;      &#x9;&#x9;Iif([ERP_Rechnungsart_BT3] == '380' And [ERP_Art] == 0,&#xA;        &#x9;' Total payable: ',&#xA;        &#x9;''&#xA;      &#x9;&#x9;),&#xA;&#xA;      [_SprachCodeERP] == 2,'Moins ' + FormatString('{0:0.##}', [ERP_SkontoProzent]) +&#xA;      ' % d’escompte jusqu au ' + FormatString('{0:dd.MM.yyyy}', [ERP_SkontoFristDat]) +&#xA;      ' sur les articles éligibles.' +&#xA;      &#x9;&#x9;Iif([ERP_Rechnungsart_BT3] == '380' And [ERP_Art] == 0,&#xA;        &#x9;' Montant à payer: ',&#xA;        &#x9;''&#xA;      &#x9;&#x9;),&#xA;    &#x9;[_SprachCodeERP] == 3, 'Min ' +  FormatString('{0:0.##}', [ERP_SkontoProzent]) +&#xA;      ' % korting bij betaling tot  ' + FormatString('{0:dd.MM.yyyy}', [ERP_SkontoFristDat]) +&#xA;      ' op de afgeprijsde artikelen.' +&#xA;&#x9;&#x9;Iif([ERP_Rechnungsart_BT3] == '380' And [ERP_Art] == 0,&#xA;        &#x9;' Betaalbedrag: ',&#xA;        &#x9;''&#xA;      &#x9;&#x9;),&#xA;&#x9;''&#xA;  ) +&#xA;/* Hinweis: Zahlbetrag wird nur berechnet und ausgegeben wenn es eine normale Rechnung ist! */&#xA;  Iif([ERP_Rechnungsart_BT3] == '380' And [ERP_Art] == 0,&#xA;    FormatString('{0:N2}', sumSum([calcSumGesamtBrutto]) - sumSum([calcSumSkontoPosBetrag])) + ' ' + [_Währung],&#xA;    ''&#xA;  ),&#xA;  ''&#xA;)&#xA;" />
              </ExpressionBindings>
              <StylePriority Ref="1643" UsePadding="false" />
            </Item2>
          </Controls>
          <ExpressionBindings>
            <Item1 Ref="1644" EventName="BeforePrint" PropertyName="Visible" Expression="Iif(&#xA;&#x9;[ERP_ZahlungsCode] == 0 And &#xA;&#x9;[ERP_BZObjType] == '7' And &#xA;&#x9;[ERP_SkontoProzent] != 0 And&#xA;&#x9;Not [bool_ERPKorrektur],&#xA;&#x9;True, &#xA;&#x9;False&#xA;)&#xA;" />
          </ExpressionBindings>
        </Item9>
